---
import { getCollection } from "astro:content";
import PostList from "@/components/blog/PostList.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { isPostListable } from "@/config/blog";
import Layout from "@/layouts/Layout.astro";

const ogTitle = "Writing";
const ogDescription =
	"Technical articles on AI engineering, developer tools, context engineering, and building in public by Railly Hugo.";
const ogImage = `/api/og?title=${encodeURIComponent(ogTitle)}&description=${encodeURIComponent(ogDescription)}&tag=writing`;

const allPosts = await getCollection("blog", ({ data }) => {
	return import.meta.env.PROD ? data.status !== "draft" : true;
});

const activePosts = allPosts
	.filter(({ data }) => isPostListable(data))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const archivedPosts = allPosts
	.filter(({ data }) => data.status === "archived")
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = activePosts.reduce(
	(acc, post) => {
		const year = post.data.pubDate.getFullYear();
		if (!acc[year]) acc[year] = [];
		acc[year].push(post);
		return acc;
	},
	{} as Record<number, typeof activePosts>,
);

const years = Object.keys(postsByYear)
	.map(Number)
	.sort((a, b) => b - a);

const newestPost = activePosts[0];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const eyebrow = [
	plural(activePosts.length, "post"),
	years.length > 1
		? `${years[years.length - 1]} – ${years[0]}`
		: String(years[0] ?? ""),
].filter(Boolean);
---

<Layout
    title="Writing - Railly Hugo"
    description={ogDescription}
    image={ogImage}
>
    <PageLayout class="flex flex-col">
        <PageHero eyebrow={eyebrow} title="Writing" lede={ogDescription} />

        {
            years.map((year, i) => (
                <Section
                    id={`h-${year}`}
                    number={i + 1}
                    title={String(year)}
                    note={plural(postsByYear[year].length, "post")}
                    class={i === 0 ? "mt-16" : "mt-14"}
                >
                    <PostList posts={postsByYear[year]} newestSlug={newestPost?.slug} views />
                </Section>
            ))
        }
        {
            activePosts.length === 0 && (
                <div class="py-12 text-center">
                    <p class="text-foreground-2">More stories coming soon</p>
                </div>
            )
        }

        {
            archivedPosts.length > 0 && (
                <>
                    <archive-toggle class="mt-14 block">
                        <button type="button" class="ed-label inline-flex items-center gap-1.5 hover:text-foreground" aria-expanded="false">
                            <span>archive</span>
                            <svg
                                width="10"
                                height="10"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="archive-icon transition-transform duration-200"
                                aria-hidden="true"
                            >
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                    </archive-toggle>
                    <Section
                        id="h-archive"
                        number={years.length + 1}
                        title="Archive"
                        note="Older writings — kept for reference"
                        class="archived-posts mt-8 hidden"
                    >
                        <PostList posts={archivedPosts} yearIndex class="opacity-70" />
                    </Section>
                </>
            )
        }
    </PageLayout>
</Layout>

<script>
    class ArchiveToggle extends HTMLElement {
        connectedCallback() {
            const button = this.querySelector('button');
            const icon = this.querySelector('.archive-icon');
            const archivedSection = document.querySelector('.archived-posts');

            if (button && icon && archivedSection) {
                button.addEventListener('click', () => {
                    const isHidden = archivedSection.classList.contains('hidden');
                    button.setAttribute('aria-expanded', String(isHidden));

                    if (isHidden) {
                        archivedSection.classList.remove('hidden');
                        icon.classList.add('rotate-180');
                    } else {
                        archivedSection.classList.add('hidden');
                        icon.classList.remove('rotate-180');
                    }
                });
            }
        }
    }

    customElements.define('archive-toggle', ArchiveToggle);
</script>

<script>
    const spans = document.querySelectorAll<HTMLElement>("[data-views-slug]");
    const slugs = [...spans].map((s) => s.dataset.viewsSlug).filter(Boolean) as string[];
    const isLocal = ["localhost", "127.0.0.1"].includes(location.hostname);
    if (slugs.length > 0 && !isLocal) {
        fetch(`/api/views-batch?ids=${slugs.slice(0, 100).join(",")}`)
            .then((r) => (r.ok ? r.json() : null))
            .then((data) => {
                if (!data?.views) return;
                for (const span of spans) {
                    const slug = span.dataset.viewsSlug;
                    if (!slug) continue;
                    const n = data.views[slug] ?? 0;
                    span.textContent = `${n.toLocaleString()} ${n === 1 ? "view" : "views"}`;
                }
            })
            .catch(() => {});
    }
</script>
