---
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";

Astro.response.status = 404;

const links = [
	{ title: "Home", href: "/" },
	{ title: "Developer resources", href: "/developers" },
	{ title: "Projects", href: "/projects" },
	{ title: "Writing", href: "/writing" },
	{ title: "llms.txt", href: "/llms.txt" },
	{ title: "Sitemap", href: "/sitemap-index.xml" },
];
---

<Layout
	image={ogUrl({ title: "Page not found", description: "That URL does not match a public page on railly.dev." })}
	title="Page not found | Railly Hugo"
	description="That URL does not match a public page on railly.dev. Use the recovery links to continue."
>
	<PageLayout class="flex flex-col">
		<PageHero eyebrow="404" title="Page not found">
			<Fragment slot="lede">
				That URL does not match a public page on railly.dev. Agents can request this
				same URL with <code class="ed-num text-foreground">Accept: text/markdown</code> for a compact recovery response.
			</Fragment>
		</PageHero>

		<Section id="h-recovery" number={1} title="Recovery links" class="mt-16">
			<nav aria-label="Recovery links">
				<List>
					{links.map((l) => <ListRow href={l.href} title={l.title} meta={l.href} arrow />)}
				</List>
			</nav>
		</Section>
	</PageLayout>
</Layout>
