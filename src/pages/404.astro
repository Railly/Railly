---
import Footer from "@/components/layout/Footer.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import Layout from "@/layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout
	title="Page not found | Railly Hugo"
	description="That URL does not match a public page on railly.dev. Use the recovery links to continue."
>
	<PageLayout class="flex flex-col gap-10">
		<header class="space-y-4">
			<p class="font-mono text-xs text-foreground-3">404</p>
			<h1 class="text-2xl font-semibold tracking-tight">Page not found</h1>
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				That URL does not match a public page on railly.dev. Agents can request this
				same URL with <code>Accept: text/markdown</code> for a compact recovery response.
			</p>
		</header>
		<nav aria-label="Recovery links">
			<ul class="space-y-3 text-sm">
				<li><a class="underline" href="/">Home</a></li>
				<li><a class="underline" href="/developers">Developer resources</a></li>
				<li><a class="underline" href="/projects">Projects</a></li>
				<li><a class="underline" href="/writing">Writing</a></li>
				<li><a class="underline" href="/llms.txt">llms.txt</a></li>
				<li><a class="underline" href="/sitemap-index.xml">Sitemap</a></li>
			</ul>
		</nav>
		<Footer />
	</PageLayout>
</Layout>
