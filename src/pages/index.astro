---
import BrandIcon from "@/components/brand/BrandIcon.astro";
import type { BrandName } from "@/components/brand/registry";
import Navigation from "@/components/layout/Navigation.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import AsciiField from "@/components/scene/AsciiField.astro";
import { ogUrl, siteConfig } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { compact, homeData } from "@/lib/home-data";

const { projects, posts, appearances, achievements, videos } = await homeData();
const featured = ["petdex", "makeables"];
const tools = projects.filter((p) => !featured.includes(p.slug));
const year = (d: Date) => d.getFullYear();

const experience = [
	{
		role: "Software Engineer",
		org: "Vercel Labs",
		icon: "vercel",
		when: "Jul 2026 – now",
		url: "https://vercel.com/labs",
	},
	{
		role: "AI Software Engineer",
		org: "Clerk",
		icon: "clerk",
		when: "Oct 2025 – Jun 2026",
		url: "https://clerk.com",
	},
	{
		role: "Software Engineer, contractor",
		org: "Midudev",
		icon: "midudev",
		when: "Mar 2025 – Feb 2026",
		url: "https://midu.dev",
	},
	{
		role: "Founder",
		org: "Crafter Station",
		icon: "crafterStation",
		when: "Sep 2023 – now",
		url: "https://crafter.run",
	},
] satisfies {
	role: string;
	org: string;
	icon: BrandName;
	when: string;
	url: string;
}[];

// Marks for the organizations behind each talk and prize.
const marks: [RegExp, BrandName][] = [
	[/openai|codex/i, "openai"],
	[/youtube/i, "youtube"],
	[/react/i, "react"],
	[/supabase|osscar/i, "supabase"],
	[/elevenlabs/i, "elevenlabs"],
	[/sanity/i, "sanity"],
	[/next\.js/i, "nextjs"],
	[/midudev/i, "midudev"],
	[/vercel/i, "vercel"],
	[/platanus/i, "platanusHack"],
	[/unmsm|san marcos/i, "unmsm"],
	[/ia hackathon/i, "iaHack"],
	[/crafter/i, "crafterStation"],
];
const markFor = (...texts: (string | undefined)[]) => {
	const text = texts.filter(Boolean).join(" ");
	return marks.find(([re]) => re.test(text))?.[1];
};
---

<Layout title="Railly Hugo - Open Source Developer at Vercel Labs | Crafter Station Founder" description={siteConfig.description}
	image={ogUrl({ title: "Railly Hugo", description: "I build at the frontier of what agents and interfaces can do." })}
>
	<AsciiField />
	<Navigation />
	<main class="home relative z-[1] mx-auto max-w-[42rem] px-6 pt-12 pb-16 sm:pt-20 text-[#1b1915] dark:text-[#ebe7df]">
		<header>
			<h1 class="sr-only">Railly Hugo aka Hunter</h1>
			<p class="font-serif text-[clamp(1.3rem,2.8vw,1.6rem)] leading-[1.5] tracking-[-0.01em]">
				I build at the frontier of what agents and interfaces can do. Peruvian engineer at Vercel Labs in Buenos Aires, and founder of <a href="https://crafter.run" class="u">Crafter Station</a>, a community of 1,000+ builders.
			</p>
		</header>

		<section aria-labelledby="h-now">
			<h2 id="h-now">What I've been working on</h2>
			<div class="grid gap-6 sm:grid-cols-2">
				<a href="/work/petdex" class="card">
					<div class="art art-pet" aria-hidden="true">
						<span class="sprite" style="background-image:url(/images/petdex/boba.webp)"></span>
						<span class="sprite" style="background-image:url(/images/petdex/bee-teemo.webp)"></span>
						<span class="sprite" style="background-image:url(/images/petdex/aurelion-sol.webp)"></span>
					</div>
					<h3><img src="/images/brand/petdex-mark.svg" alt="" width="16" height="16" class="mark" />Petdex</h3>
					<p>Animated pets for your coding agent. Built in a day, now 4,000+ stars, 78k npm downloads, and a dependency of Hermes Agent.</p>
				</a>
				<a href="https://makeables.dev" class="card">
					<div class="art art-make" aria-hidden="true">
						<span class="bit"></span>
					</div>
					<h3><img src="/images/brand/makeables-symbol.svg" alt="" width="16" height="16" class="mark dark:hidden" /><img src="/images/brand/makeables-symbol-light.svg" alt="" width="16" height="16" class="mark hidden dark:inline-block" />Makeables</h3>
					<p>Cards, badges and stickers that feel like you. Tell an agent what you want, get a print-ready object.</p>
				</a>
			</div>
		</section>

		<section aria-labelledby="h-tools">
			<h2 id="h-tools">Tools agents can use</h2>
			{tools.map((p) => (
				<a href={p.url} class="r">
					<span class="n"><BrandIcon name={p.icon} width={14} height={14} class="logo" />{p.name}</span><span class="d">{p.description}</span><span class="m">{p.stars >= 100 ? compact.format(p.stars) : ""}</span>
				</a>
			))}
		</section>

		<section aria-labelledby="h-work">
			<h2 id="h-work">Work</h2>
			{experience.map((e) => (
				<a href={e.url} class="r note">
					<span class="n"><BrandIcon name={e.icon} width={14} height={14} class="logo" /><span><span>{e.role}</span> <span class="ev">at {e.org}</span></span></span><span class="m w">{e.when}</span>
				</a>
			))}
		</section>

		<section aria-labelledby="h-talks">
			<h2 id="h-talks">Talks and press</h2>
			{appearances.map((a) => (
				<a href={a.url} class="r">
					<span class="n">{markFor(a.where, a.title) ? <BrandIcon name={markFor(a.where, a.title) as BrandName} width={14} height={14} class="logo" /> : <span class="logo-gap" />}{a.title}</span><span class="d">{a.where}</span><span class="m">{a.date.slice(0, 4)}</span>
				</a>
			))}
		</section>

		<section aria-labelledby="h-prizes">
			<h2 id="h-prizes">Prizes</h2>
			{achievements.map((a) => (
				<a href={a.eventUrl} class="r note">
					<span class="n">{markFor(a.achievement, a.event) ? <BrandIcon name={markFor(a.achievement, a.event) as BrandName} width={14} height={14} class="logo" /> : <span class="logo-gap" />}<span><span>{a.achievement}</span> <span class="ev">at {a.event}</span></span></span><span class="m">{a.year}</span>
				</a>
			))}
		</section>

		<section aria-labelledby="h-notes">
			<h2 id="h-notes">Notes</h2>
			{posts.map((p) => (
				<a href={`/blog/${p.slug}`} class="r note"><span class="n">{p.data.title}</span><span class="m">{year(p.data.pubDate)}</span></a>
			))}
		</section>

		<section aria-labelledby="h-videos">
			<h2 id="h-videos">Videos</h2>
			<div class="vg">
				{videos.map((v) => (
					<a href={v.url} class="r v">
						<img src={v.thumbnail} alt="" loading="lazy" />
						<span class="n">{v.title}</span>
					</a>
				))}
			</div>
		</section>

		<section aria-labelledby="h-connect">
			<h2 id="h-connect">Connect</h2>
			<p class="text-[14.5px] opacity-80">Reach out at <a href="mailto:hi@railly.dev" class="u">hi@railly.dev</a></p>
			<p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[14.5px]">
				<a href="https://github.com/railly" class="u">GitHub</a>
				<a href="https://x.com/raillyhugo" class="u">X</a>
				<a href="/writing" class="u">Writing</a>
				<a href="/about" class="u">About</a>
			</p>
		</section>

		<SiteFooter />
	</main>
</Layout>

<style>
	section {
		margin-top: 4.5rem;
	}
	h2 {
		font-size: 15px;
		font-weight: 500;
		margin-bottom: 1rem;
	}
	.u {
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, currentColor 30%, transparent);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
		transition: text-decoration-color 0.2s ease;
	}
	.u:hover {
		text-decoration-color: currentColor;
	}

	.card {
		display: block;
		border-radius: 4px;
	}
	.card h3 {
		margin-top: 0.85rem;
		font-size: 14.5px;
		font-weight: 500;
	}
	.card p {
		margin-top: 0.2rem;
		font-size: 14.5px;
		line-height: 1.5;
		opacity: 0.6;
	}
	.card:hover h3 {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}
	/* Each card is a small pixel tile: dot grid, stepped border, sprites kept crisp. */
	.art {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 4%;
		aspect-ratio: 16 / 10;
		padding: 0 8% 7%;
		border-radius: 4px;
		overflow: hidden;
		background-image: radial-gradient(color-mix(in oklab, currentColor 16%, transparent) 1px, transparent 1.2px);
		background-size: 8px 8px;
		box-shadow:
			inset 0 0 0 1px color-mix(in oklab, currentColor 12%, transparent),
			3px 3px 0 color-mix(in oklab, currentColor 10%, transparent);
		transition: box-shadow 0.25s ease;
	}
	.art-pet {
		background-color: #ece4f4;
	}
	/* Makeables keeps its brand tile: acid Bit on near-black, in both themes. */
	.art-make {
		align-items: center;
		padding: 0;
		background-color: #0f0f0e;
		color: #d7ff3c;
	}
	.bit {
		width: 34%;
		aspect-ratio: 108 / 112;
		background: #d7ff3c;
		-webkit-mask: url(/images/brand/makeables-symbol.svg) center / contain no-repeat;
		mask: url(/images/brand/makeables-symbol.svg) center / contain no-repeat;
		animation: bob 1.6s steps(2) infinite;
	}
	@keyframes bob {
		50% { transform: translateY(-4%); }
	}
	@media (prefers-color-scheme: dark) {
		.art-pet {
			background-color: #1d1a26;
		}
	}
	/* Petdex previews are 6-frame strips: play them as an idle loop. */
	.sprite {
		width: 26%;
		aspect-ratio: 192 / 208;
		background-size: 600% 100%;
		image-rendering: pixelated;
		animation: idle 0.9s steps(6) infinite;
	}
	.sprite:nth-child(2) {
		width: 32%;
		animation-delay: -0.3s;
	}
	.sprite:nth-child(3) {
		animation-delay: -0.6s;
	}
	@keyframes idle {
		from { background-position: 0 0; }
		to { background-position: 120% 0; }
	}
	.card:hover .art {
		box-shadow:
			inset 0 0 0 1px color-mix(in oklab, currentColor 22%, transparent),
			3px 3px 0 color-mix(in oklab, currentColor 18%, transparent);
	}
	.card h3 .mark {
		display: inline-block;
		width: 16px;
		height: 16px;
		margin-right: 0.45rem;
		vertical-align: -0.2em;
		border-radius: 3px;
	}
	.card h3 .mark.hidden {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		.card h3 .mark.dark\:hidden {
			display: none;
		}
		.card h3 .mark.hidden {
			display: inline-block;
		}
	}
	.card:focus-visible,
	.r:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	.road {
		border-color: color-mix(in oklab, currentColor 12%, transparent);
	}

	.r {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) 3rem;
		gap: 1rem;
		align-items: baseline;
		padding: 0.5rem 0;
		font-size: 14.5px;
		line-height: 1.45;
		border-top: 1px solid color-mix(in oklab, currentColor 9%, transparent);
	}
	.r.note {
		grid-template-columns: minmax(0, 1fr) 3rem;
	}
	.r .m.w {
		white-space: nowrap;
	}
	.r.note:has(.w) {
		grid-template-columns: minmax(0, 1fr) auto;
	}
	.r .n {
		display: inline-flex;
		align-items: baseline;
	}
	.r :global(.logo),
	.r .logo-gap {
		align-self: center;
		display: inline-block;
		flex-shrink: 0;
		margin-right: 0.5rem;
	}
	.r .logo-gap {
		width: 14px;
	}
	.r :global(.logo) {
		filter: grayscale(1);
		opacity: 0.75;
		transition: opacity 0.2s ease;
	}
	.r:hover :global(.logo) {
		opacity: 1;
	}
	.r .ev,
	.r .d,
	.r .m {
		opacity: 0.55;
	}
	.r .m {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.r:hover .n {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}
	.vg {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem 1rem;
	}
	.r.v {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border-top: 0;
		padding: 0;
	}
	.r.v img {
		aspect-ratio: 16 / 9;
		width: 100%;
		object-fit: cover;
		border-radius: 3px;
		filter: grayscale(1) contrast(1.05);
		opacity: 0.85;
		transition: filter 0.4s ease, opacity 0.4s ease;
	}
	.r.v:hover img {
		filter: none;
		opacity: 1;
	}
	.r.v .n {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 640px) {
		.vg {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.r {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.r .d {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sprite,
		.bit {
			animation: none;
		}
	}
</style>

