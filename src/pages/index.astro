---
import { getCollection } from "astro:content";
import PremiereCountdown from "@/components/blog/PremiereCountdown";
import { MakeablesSheet } from "@/components/home/MakeablesSheet";
import Footer from "@/components/layout/Footer.astro";
import HeroSection from "@/components/layout/HeroSection.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import NewsletterSection from "@/components/newsletter/NewsletterSection.astro";
import SectionLink from "@/components/ui/SectionLink.astro";
import { isPostListable } from "@/config/blog";
import { ogUrl, siteConfig } from "@/config/site";
import { achievements } from "@/data/achievements";
import { appearances } from "@/data/appearances";
import { featuredProjects } from "@/data/projects";
import youtube from "@/data/youtube.json";
import Layout from "@/layouts/Layout.astro";
import { withRepoStars } from "@/lib/github-stars";

const ogImage = ogUrl({
	title: "Railly Hugo",
	description: "I build at the frontier of what agents and interfaces can do.",
});

const allPosts = await getCollection("blog", ({ data }) =>
	import.meta.env.PROD ? data.status !== "draft" : true,
);
const activePosts = allPosts
	.filter(({ data }) => isPostListable(data))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = activePosts.slice(0, 5);
const formatDate = (date: Date) =>
	`${date.getDate().toString().padStart(2, "0")}/${(date.getMonth() + 1).toString().padStart(2, "0")}`;

const highlightedAchievements = achievements.filter((item) => item.highlight);

// Editorial order: the order in projects.ts, not star count.
const selectedProjects = await withRepoStars(featuredProjects);

const compact = new Intl.NumberFormat("en-US", {
	notation: "compact",
	maximumFractionDigits: 1,
});
---

<Layout
	title="Railly Hugo - Software Engineer at Vercel Labs | Crafter Station Founder"
	description={siteConfig.description}
	image={ogImage}
>
	<PageLayout class="flex flex-col gap-16">
		<HeroSection name={siteConfig.name} title={siteConfig.hero.title} />

		<section>
			<SectionLink title="Now building" href="https://makeables.dev" viewAllLabel="makeables.dev" />
			<p class="mb-5 text-[15px] leading-relaxed text-foreground-2">
				<span class="text-foreground">Makeables.</span> You and your coding agent design stickers, badges and cards from a brand, and they come out ready for the print shop. Throw them, stack them, or pull an edge to peel one off.
			</p>
			<MakeablesSheet client:visible />
		</section>

		<section>
			<SectionLink title="Work" href="/projects" />
			{selectedProjects.map((project) => (
				<a
					href={project.url}
					target={project.url.startsWith("http") ? "_blank" : undefined}
					rel="noopener noreferrer"
					class="group flex items-baseline gap-4 py-1.5 text-[15px]"
				>
					<span class="shrink-0 text-foreground">{project.name}</span>
					<span class="min-w-0 flex-1 truncate text-foreground-3 transition-colors group-hover:text-foreground-2">{project.role ?? project.description}</span>
					{project.stars >= 100 && <span class="shrink-0 text-sm tabular-nums text-foreground-3">{compact.format(project.stars)}</span>}
				</a>
			))}
		</section>

		<section>
			<SectionLink title="Writing" href="/writing" />
			{recentPosts.map((post) => {
				const isPremiere = post.data.status === "premiere" && new Date() < post.data.pubDate;
				return isPremiere ? (
					<div class="group flex items-baseline gap-4 py-1.5 text-[15px]">
						<span class="min-w-0 flex-1 text-foreground-3">{post.data.title}</span>
						<PremiereCountdown pubDate={post.data.pubDate.toISOString()} client:load />
					</div>
				) : (
					<a href={`/blog/${post.slug}`} class="group flex items-baseline gap-4 py-1.5 text-[15px]">
						<span class="min-w-0 flex-1 text-foreground transition-colors group-hover:text-foreground-2">{post.data.title}</span>
						<span class="shrink-0 text-sm tabular-nums text-foreground-3">{formatDate(post.data.pubDate)}/{String(post.data.pubDate.getFullYear()).slice(2)}</span>
					</a>
				);
			})}
			{recentPosts.length === 0 && <p class="text-foreground-3">More soon.</p>}
		</section>

		<section>
			<SectionLink title="Videos" href="https://www.youtube.com/@raillydev" viewAllLabel="youtube" />
			{youtube.videos.map((video) => (
				<a href={video.url} target="_blank" rel="noopener noreferrer" class="group flex items-baseline gap-4 py-1.5 text-[15px]">
					<span class="min-w-0 flex-1 truncate text-foreground transition-colors group-hover:text-foreground-2">{video.title}</span>
				</a>
			))}
		</section>

		<section>
			<SectionLink title="Talks and press" href="/press" />
			{appearances.map((item) => {
				const Tag = item.url ? "a" : "div";
				return (
					<Tag {...(item.url ? { href: item.url, target: "_blank", rel: "noopener noreferrer" } : {})} class="group flex items-baseline gap-4 py-1.5 text-[15px]">
						<span class="min-w-0 flex-1 truncate">
							<span class="text-foreground transition-colors group-hover:text-foreground-2">{item.title}</span>
							<span class="ml-2 text-foreground-3">{item.where}</span>
						</span>
						<span class="shrink-0 text-sm tabular-nums text-foreground-3">{item.date.slice(0, 4)}</span>
					</Tag>
				);
			})}
		</section>

		<section>
			<SectionLink title="Recognition" href="/about#achievements" />
			{highlightedAchievements.map((item) => {
				const Tag = item.eventUrl ? "a" : "div";
				return (
					<Tag {...(item.eventUrl ? { href: item.eventUrl, target: "_blank", rel: "noopener noreferrer" } : {})} class="group flex items-baseline gap-4 py-1.5 text-[15px]">
						<span class="min-w-0 flex-1 truncate">
							<span class="text-foreground transition-colors group-hover:text-foreground-2">{item.achievement}</span>
							<span class="ml-2 text-foreground-3">{item.event}</span>
						</span>
						<span class="shrink-0 text-sm tabular-nums text-foreground-3">{item.year}</span>
					</Tag>
				);
			})}
		</section>

		<NewsletterSection />
		<Footer />
	</PageLayout>
</Layout>
