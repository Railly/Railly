---
import Button from "@/components/editorial/Button.astro";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import LinkedStats from "@/components/press/LinkedStats.astro";
import Layout from "@/layouts/Layout.astro";

const updatedAt = "October 20, 2026";
const ogTitle = "Press kit";
const ogDescription =
	"Press resources, verified facts, biographies, and media assets for Railly Hugo, creator of Petdex and founder of Crafter Station.";
const ogImage = `/api/og?title=${encodeURIComponent(ogTitle)}&description=${encodeURIComponent(ogDescription)}&tag=press`;

const metrics = [
	{
		value: "4,261",
		label: "Petdex GitHub stars",
		href: "https://github.com/crafter-station/petdex",
		note: "Public snapshot",
	},
	{
		value: "210",
		label: "Petdex forks",
		href: "https://github.com/crafter-station/petdex",
		note: "Public snapshot",
	},
	{
		value: "690",
		label: "Petdex contributions by Railly",
		href: "https://api.github.com/repos/crafter-station/petdex/contributors",
		note: "Principal contributor",
	},
	{
		value: "1,000+",
		label: "Crafter Station builders",
		href: "https://www.linkedin.com/company/crafter-station/posts/",
		note: "July 2026 announcement",
	},
];

const validation = [
	{
		title: "Hermes Agent consumes Petdex directly",
		detail:
			"Hermes Agent fetches Petdex's public manifest and uses its spritesheet, JSON, and ZIP asset URLs. Hermes had more than 223,000 GitHub stars at this snapshot.",
		href: "https://github.com/NousResearch/hermes-agent/blob/main/agent/pet/manifest.py",
		linkLabel: "View the integration",
	},
	{
		title: "Petdex cited by Decrypt",
		detail:
			"Decrypt cited Petdex as the source of more than 3,200 sprites in its coverage of the Hermes pets feature.",
		href: "https://decrypt.co/es/372082/tu-agente-hermes-ahora-tiene-una-mascota-que-no-hace-absolutamente-nada-y-ese-es-el-punto",
		linkLabel: "Read the coverage",
	},
	{
		title: "Next.js Global Hackathon winner",
		detail:
			"Text0, created with Anthony Cueva, was selected as an official winner of the first Next.js Global Hackathon in 2025.",
		href: "https://community.vercel.com/t/news-cache-2025-04-28/9427",
		linkLabel: "See the official announcement",
	},
];

const topics = [
	"Open source infrastructure for AI agents",
	"Developer tools and agent-first interfaces",
	"Building global technology from Latin America",
	"Turning technology communities into shipped projects",
	"Building in public as a career and distribution system",
];
---

<Layout
	title="Press kit - Railly Hugo"
	description={ogDescription}
	image={ogImage}
>
	<PageLayout class="flex flex-col">
		<div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_11rem] sm:items-end">
			<PageHero
				eyebrow={["Press kit", "Railly Hugo"]}
				title="Railly Hugo builds open source infrastructure and communities for the next generation of software builders."
				lede="Peruvian software engineer based in Buenos Aires, creator and principal contributor of Petdex, founder of Crafter Station, and Software Engineer at Vercel Labs."
				class="gap-5"
			/>
			<figure class="ed-tile overflow-hidden bg-background-2 max-sm:max-w-[13rem]">
				<img
					src="/images/railly-hugo-headshot.webp"
					alt="Railly Hugo"
					class="aspect-square w-full object-cover"
					width="1200"
					height="1200"
					loading="eager"
				/>
			</figure>
		</div>
		<div class="ed mt-6 flex flex-wrap gap-3">
			<Button href="mailto:hi@railly.dev" variant="primary">hi@railly.dev</Button>
			<Button href="https://github.com/Railly" external>GitHub</Button>
			<Button href="https://linkedin.com/in/railly-hugo" external>LinkedIn</Button>
		</div>

		<Section id="h-snapshot" number={1} title="Verified snapshot" note={updatedAt} class="mt-16">
			<LinkedStats stats={metrics.map((m) => ({ value: m.value, label: m.label, href: m.href, note: m.note }))} />
		</Section>

		<Section id="h-story" number={2} title="Primary story">
			<div class="ed-tile flex flex-col gap-5 bg-[var(--ed-wash)] p-6 sm:p-8">
				<p class="ed-display">
					A project created by a Peruvian builder became infrastructure for one of GitHub's largest open source AI agent repositories.
				</p>
				<p class="text-[14.5px] leading-relaxed text-foreground-2">
					Petdex is an open source gallery of animated companions for coding agents. Hermes Agent consumes Petdex's public manifest directly, turning the catalog into an integration surface rather than a standalone gallery. The larger story connects open source product adoption with Crafter Station's work helping Latin American builders create and ship technology.
				</p>
				<div class="flex flex-wrap gap-3 pt-1">
					<Button href="https://petdex.dev" variant="primary" external>Open Petdex</Button>
					<Button href="https://github.com/crafter-station/petdex" external>View source</Button>
					<Button href="/press/petdex-impact">Read the Q2 impact report <span aria-hidden="true">&rarr;</span></Button>
				</div>
			</div>
		</Section>

		<Section id="h-validation" number={3} title="Independent validation">
			<List>
				{validation.map((item, i) => (
					<ListRow href={item.href} external index={`${String.fromCharCode(97 + i)}.`} title={item.title}>
						<span slot="description" class="flex flex-col gap-2">
							<span>{item.detail}</span>
							<span class="ed-label text-foreground-2">{item.linkLabel} &nearr;</span>
						</span>
					</ListRow>
				))}
			</List>
		</Section>

		<Section id="h-bios" number={4} title="Biographies">
			<div class="grid gap-x-10 gap-y-8 lg:grid-cols-2">
				<div lang="es" class="flex flex-col gap-3 border-t border-[var(--ed-line)] pt-4">
					<h3 class="ed-label">Español</h3>
					<p class="text-sm leading-relaxed text-foreground-2">
						Railly Hugo es un ingeniero de software peruano, creador principal de Petdex y fundador de Crafter Station. Actualmente trabaja en Vercel Labs y construye herramientas open source para agentes de IA, además de programas que ayudan a builders latinoamericanos a publicar productos.
					</p>
					<p class="text-sm leading-relaxed text-foreground-2">
						Nacido en Lima y radicado en Buenos Aires, Railly lidera Petdex, una galería open source de mascotas animadas para agentes de programación con más de 4.200 estrellas en GitHub. Su catálogo es consumido directamente por Hermes Agent mediante una API pública. También fundó Crafter Station, una organización comunitaria sin fines de lucro enfocada en crear, publicar y fortalecer el ecosistema tecnológico del Perú. En 2025, Text0, proyecto creado junto a Anthony Cueva, fue reconocido como ganador oficial del primer Next.js Global Hackathon. Antes de incorporarse a Vercel Labs, trabajó en evaluaciones de IA y developer tooling en Clerk.
					</p>
				</div>
				<div lang="en" class="flex flex-col gap-3 border-t border-[var(--ed-line)] pt-4">
					<h3 class="ed-label">English</h3>
					<p class="text-sm leading-relaxed text-foreground-2">
						Railly Hugo is a Peruvian software engineer, principal creator of Petdex, and founder of Crafter Station. He currently works at Vercel Labs and builds open source tools for AI agents alongside programs that help Latin American builders ship products.
					</p>
					<p class="text-sm leading-relaxed text-foreground-2">
						Born in Lima and based in Buenos Aires, Railly leads Petdex, an open source gallery of animated companions for coding agents with more than 4,200 GitHub stars. Hermes Agent consumes its catalog directly through a public API. He also founded Crafter Station, a nonprofit community organization focused on creating, shipping, and strengthening Peru's technology ecosystem. In 2025, Text0, built with Anthony Cueva, was recognized as an official winner of the first Next.js Global Hackathon. Before joining Vercel Labs, he worked on AI evaluations and developer tooling at Clerk.
					</p>
				</div>
			</div>
		</Section>

		<Section id="h-topics" number={5} title="Interview topics">
			<List>
				{topics.map((topic, i) => <ListRow dense index={`${String.fromCharCode(97 + i)}.`} title={topic} />)}
			</List>
		</Section>

		<Section id="h-assets" number={6} title="Media assets">
			<ul class="grid gap-4 sm:grid-cols-2">
				<li>
					<a href="/images/railly-hugo-headshot.png" download="railly-hugo-headshot.png" class="ed ed-tile ed-tile-box flex h-full items-center gap-4 p-4">
						<img src="/images/railly-hugo-headshot.webp" alt="" width="48" height="48" class="size-12 shrink-0 rounded-[3px] object-cover" loading="lazy" />
						<span class="flex min-w-0 flex-col gap-1">
							<span class="text-[14.5px] font-medium">High-resolution headshot</span>
							<span class="ed-label">2048 x 2048</span>
						</span>
						<span aria-hidden="true" class="ml-auto text-foreground-3">&darr;</span>
					</a>
				</li>
				<li>
					<a href="mailto:hi@railly.dev?subject=Railly%20Hugo%20media%20assets" class="ed ed-tile ed-tile-box flex h-full items-center gap-4 p-4">
						<span aria-hidden="true" class="ed-art size-12 shrink-0 bg-background-2"></span>
						<span class="flex min-w-0 flex-col gap-1">
							<span class="text-[14.5px] font-medium">Request product or event images</span>
							<span class="ed-label">email</span>
						</span>
						<span aria-hidden="true" class="ml-auto text-foreground-3">&rarr;</span>
					</a>
				</li>
			</ul>
		</Section>

		<Section id="h-contact" number={7} title="Press contact">
			<p class="text-[15px] leading-relaxed text-foreground-2">
				For interviews, fact checks, or additional assets, email <a href="mailto:hi@railly.dev" class="ed-link text-foreground">hi@railly.dev</a>. Railly speaks independently about his open source and community work, not on behalf of Vercel.
			</p>
		</Section>
	</PageLayout>
</Layout>
