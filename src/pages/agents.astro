---
import BrandIcon from "@/components/brand/BrandIcon.astro";
import type { BrandName } from "@/components/brand/registry";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import Tile from "@/components/editorial/Tile.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import Layout from "@/layouts/Layout.astro";

const ogTitle = "Agent-first developer tools";
const ogDescription = "Tools I'm building for AI agents, not humans.";
const ogImage = `/api/og?title=${encodeURIComponent(ogTitle)}&description=${encodeURIComponent(ogDescription)}&tag=agents`;

type Tag = {
	label: string;
};

type HeroCliEntry = {
	name: string;
	tagline: string;
	description: string;
	tags: Tag[];
	github?: string;
	npm?: string;
	site?: string;
	blogPost?: string;
	private?: boolean;
};

type GridCliEntry = {
	name: string;
	stars: number;
	description: string;
	github: string;
	npm?: string;
	icon?: BrandName;
};

const heroClis: HeroCliEntry[] = [
	{
		name: "webctl",
		tagline: "Turn any website into an installable CLI.",
		description:
			"Reverse-engineers sites into declarative IRs. Built on agent-browser, emits just-bash ExecutorConfigs. Recon once, zero LLM tokens at runtime.",
		tags: [
			{ label: "Rust" },
			{ label: "agent-browser" },
			{ label: "just-bash" },
		],
		github: "https://github.com/crafter-station/webctl",
		site: "https://v0-webctl.vercel.app",
		blogPost: "/blog/webctl",
	},
	{
		name: "v0-cli",
		tagline: "Agents shipping UI on Vercel.",
		description:
			"Wrapper for the v0 Platform API. JSON dual-mode, intent tokens for deploys, audit trail.",
		tags: [{ label: "npm" }, { label: "MCP" }, { label: "Vercel" }],
		npm: "https://www.npmjs.com/package/@crafter/v0-cli",
		github: "https://github.com/Railly/v0-cli",
		site: "https://v0-cli.crafter.run",
	},
	{
		name: "broker-cli",
		tagline: "Agents touching real money, safely.",
		description:
			"Trust ladder, killswitch, MCP, audit log. Production CLI on a brokerage account.",
		tags: [
			{ label: "production" },
			{ label: "MCP server" },
			{ label: "trust ladder" },
		],
		private: true,
	},
	{
		name: "cligentic",
		tagline: "Copy-paste blocks for agent-first CLIs.",
		description:
			"shadcn for agent CLIs. Trust ladder, killswitch, audit log, JSON dual-mode, all as installable blocks.",
		tags: [
			{ label: "blocks" },
			{ label: "agent-first" },
			{ label: "registry" },
		],
		site: "https://cligentic.railly.dev",
		github: "https://github.com/Railly/cligentic",
	},
];

const gridClis: GridCliEntry[] = [
	{
		name: "agentfiles",
		icon: "agentfiles",
		stars: 529,
		description: "Manage agent files across 13+ tools. From Obsidian.",
		github: "https://github.com/Railly/agentfiles",
	},
	{
		name: "skill-kit",
		icon: "skillKit",
		stars: 56,
		description: "Local-first analytics for agent skills.",
		github: "https://github.com/crafter-station/skill-kit",
	},
	{
		name: "trx",
		icon: "trx",
		stars: 78,
		description: "Agent-native transcription via Whisper.",
		github: "https://github.com/crafter-station/trx",
		npm: "https://www.npmjs.com/package/@crafter/trx",
	},
	{
		name: "spoti-cli",
		icon: "spotiCli",
		stars: 0,
		description: "Spotify Web API for agents.",
		github: "https://github.com/crafter-station/spoti-cli",
		npm: "https://www.npmjs.com/package/@crafter/spoti-cli",
	},
	{
		name: "sunat-cli",
		icon: "sunatCli",
		stars: 0,
		description: "Peruvian tax automation for agents (SUNAT).",
		github: "https://github.com/crafter-station/sunat-cli",
		npm: "https://www.npmjs.com/package/@crafter/sunat-cli",
	},
];
const prs = [
	{
		repo: "vercel-labs/emulate",
		pr: 38,
		state: "merged",
		title: "Clerk emulator package (OIDC, JWKS, OAuth, Backend API, 55 tests)",
		note: "co-authored with Chris Tate",
		url: "https://github.com/vercel-labs/emulate/pull/38",
	},
	{
		repo: "vercel-labs/agent-browser",
		pr: 1141,
		state: "open",
		title: "Policy check now matches CLI parent commands",
		note: null,
		url: "https://github.com/vercel-labs/agent-browser/pull/1141",
	},
	{
		repo: "vercel-labs/workflow-builder-template",
		pr: 76,
		state: "merged",
		title: "Clerk integration plugin",
		note: null,
		url: "https://github.com/vercel-labs/workflow-builder-template/pull/76",
	},
];

// Text links under each stack tile, in the order the old icon row used.
const linksFor = (cli: HeroCliEntry) =>
	[
		cli.github && { label: "GitHub", href: cli.github, external: true },
		cli.site && { label: "Site", href: cli.site, external: true },
		cli.npm && { label: "npm", href: cli.npm, external: true },
		cli.blogPost && { label: "Post", href: cli.blogPost, external: false },
	].filter((l): l is { label: string; href: string; external: boolean } =>
		Boolean(l),
	);
---

<Layout
	title="Agent-first developer tools - Railly Hugo"
	description={ogDescription}
	image={ogImage}
>
	<PageLayout class="flex flex-col">
		<PageHero
			eyebrow={["Agents", `${heroClis.length + gridClis.length} CLIs`, `${prs.length} PRs to Vercel Labs`]}
			title="Agent-first developer tools"
			lede="Tools I'm building for AI agents, not humans."
		/>

		<Section id="h-labs" number={1} title="Contributing to Vercel Labs" note="Pull requests" class="mt-16">
			<List>
				{prs.map((pr) => (
					<ListRow href={pr.url} external meta={pr.state}>
						<BrandIcon slot="leading" name="vercel" width={14} height={14} />
						<span slot="title" class="repo">{pr.repo}<span class="text-foreground-3">#{pr.pr}</span></span>
						<Fragment slot="description">{pr.title}{pr.note && <span class="text-foreground-3"> ({pr.note})</span>}</Fragment>
					</ListRow>
				))}
			</List>
		</Section>

		<Section id="h-stack" number={2} title="The stack">
			<div class="grid gap-5 sm:grid-cols-2">
				{heroClis.map((cli) => {
					const links = linksFor(cli);
					return (
						<Tile as="article" class="flex flex-col gap-3 p-5">
							<div class="flex flex-col gap-1">
								<h3 class="font-serif text-[21px] leading-snug text-foreground">{cli.name}</h3>
								<p class="text-[14.5px] leading-snug text-foreground-2">{cli.tagline}</p>
							</div>
							<p class="text-[13.5px] leading-relaxed text-foreground-3">{cli.description}</p>
							<p class="ed-label">{cli.tags.map((t) => t.label).join(" · ")}</p>
							<div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 border-t border-[var(--ed-line)] pt-3 text-[13.5px]">
								{links.length > 0 ? (
									links.map((l) => (
										<a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener noreferrer" : undefined} class="ed-link">{l.label}</a>
									))
								) : (
									cli.private && <span class="ed-label">private</span>
								)}
							</div>
						</Tile>
					);
				})}
			</div>
		</Section>

		<Section id="h-more" number={3} title="More shipped" note="GitHub stars">
			<List>
				{gridClis.map((cli) => (
					<ListRow meta={cli.stars > 0 ? cli.stars : ""}>
						{cli.icon ? <BrandIcon slot="leading" name={cli.icon} width={14} height={14} /> : <span slot="leading" />}
						<a slot="title" href={cli.github} target="_blank" rel="noopener noreferrer" class="ed-link">{cli.name}</a>
						<Fragment slot="description">
							{cli.description}
							{cli.npm && <a href={cli.npm} target="_blank" rel="noopener noreferrer" class="ed-label ml-1.5">npm</a>}
						</Fragment>
					</ListRow>
				))}
			</List>
		</Section>
	</PageLayout>
</Layout>

<style>
	/* Long repo slugs wrap instead of pushing the row past a phone's width. */
	.repo {
		overflow-wrap: anywhere;
	}
</style>
