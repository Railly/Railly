---
import { getCollection } from "astro:content";
import ArticleGrid from "@/components/blog/ArticleGrid.astro";
import ArticleHeader from "@/components/blog/ArticleHeader.astro";
import ArticleProse from "@/components/blog/ArticleProse.astro";
import Link from "@/components/content/Link.astro";
import Quote from "@/components/content/Quote.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import DraftComments from "@/components/drafts/DraftComments";
import Navigation from "@/components/layout/Navigation.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import AsciiField from "@/components/scene/AsciiField.astro";
import { getReadingTime } from "@/config/reading-time";
import Layout from "@/layouts/Layout.astro";
import { findSlugByToken } from "@/lib/draft-token";

export const prerender = false;

const { id } = Astro.params;

const drafts = await getCollection(
	"blog",
	({ data }) => data.status === "draft",
);
const slugs = drafts.map((p) => p.slug);
const matchedSlug = findSlugByToken(id!, slugs);

if (!matchedSlug) {
	return Astro.redirect("/404");
}

const post = drafts.find((p) => p.slug === matchedSlug)!;
const { Content, headings } = await post.render();

const publishedDate = post.data.pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const ogImage = `/api/og?title=${encodeURIComponent(post.data.title)}&description=${encodeURIComponent(post.data.description || "")}&tag=draft`;
const {
	words,
	minutes,
	text: readingTimeText,
} = getReadingTime(post.body || "");
---

<Layout
	title={`[Draft] ${post.data.title}`}
	description={post.data.description}
	image={ogImage}
	article={true}
	publishedTime={post.data.pubDate}
	readingTimeMinutes={minutes}
	wordCount={words}
>
    <AsciiField clear={560} />
    <Navigation />
	<meta slot="head" name="robots" content="noindex, nofollow" />

	<DraftComments draftId={id!} client:only="react" />
	<div class="relative z-[1] w-full pt-12 pb-16 sm:pt-20">
		<ArticleGrid>
			<TableOfContents slot="aside" headings={headings} />

			<ArticleHeader
				eyebrow={[{ text: publishedDate, datetime: post.data.pubDate.toISOString() }, { text: readingTimeText, title: `${words.toLocaleString()} words` }]}
				title={post.data.title}
				description={post.data.description}
				tags={post.data.tags?.slice(0, 3)}
			>
				<p slot="before" class="ed-label ed-tile -mb-1 self-start bg-[var(--ed-wash)] px-2.5 py-1.5">
					Draft preview, not published yet.
				</p>
			</ArticleHeader>

			{
				post.data.heroImage && (
					<div class="mb-12">
						<div class="ed-tile relative aspect-[2/1] w-full overflow-hidden bg-background-2">
							<img src={post.data.heroImage.src} alt={post.data.heroImage.alt} class="h-full w-full object-cover" />
						</div>
					</div>
				)
			}

			<article class="blog-content">
				<ArticleProse>
					<Content components={{ blockquote: Quote, a: Link }} />
				</ArticleProse>
			</article>

			<footer class="mt-20 border-t border-[var(--ed-line)] pt-6">
				<p class="ed-label">Draft preview · Not indexed by search engines</p>
			</footer>
		</ArticleGrid>
	</div>

	<style>
		:target {
			scroll-margin-top: 2.5rem;
		}
	</style>
    <div class="relative z-[1] mx-auto max-w-[42rem] px-6 pb-16"><SiteFooter /></div>
</Layout>
