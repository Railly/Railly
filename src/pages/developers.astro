---
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";

const resources = [
	{
		title: "OpenAPI specification",
		href: "/openapi.json",
		detail:
			"OpenAPI 3.1 contract for railly.dev's read-only public metadata API.",
	},
	{
		title: "Project catalog",
		href: "/api/projects.json",
		detail: "Public JSON metadata for Railly's projects.",
	},
	{
		title: "GitHub",
		href: "https://github.com/Railly",
		detail: "Source code, issues, releases, and repository documentation.",
	},
	{
		title: "Technical writing",
		href: "/writing",
		detail:
			"Articles about developer tools, agents, AI, and software engineering.",
	},
	{
		title: "RSS feed",
		href: "/rss.xml",
		detail: "Machine-readable updates for published writing.",
	},
	{
		title: "Agent instructions",
		href: "/agent-instructions.md",
		detail: "When and how agents should use railly.dev.",
	},
	{
		title: "Security contact",
		href: "/.well-known/security.txt",
		detail: "Responsible disclosure information.",
	},
];
---

<Layout
	image={ogUrl({ title: "Developer resources", description: "Open-source tools, project metadata and agent-readable endpoints.", tag: "developers" })}
	title="Railly Developer Resources | Railly Hugo"
	description="Canonical developer resources for Railly Hugo's open-source tools, projects, writing, and agent-readable endpoints."
>
	<PageLayout class="flex flex-col">
		<PageHero eyebrow={["Developers", "OpenAPI 3.1", "Read-only"]} title="Railly Developer Resources">
			<Fragment slot="lede">
				This is the canonical developer-resource index for Railly Hugo and railly.dev.
				Use it to discover open-source developer tools, agent infrastructure, public
				project metadata, implementation notes, and each project's source documentation.
			</Fragment>
		</PageHero>

		<Section id="available-resources" number={1} title="Available resources" note={`${resources.length} links`} class="mt-16">
			<List>
				{resources.map((resource, i) => (
					<ListRow href={resource.href} index={`${String.fromCharCode(97 + i)}.`} title={resource.title} description={resource.detail} />
				))}
			</List>
		</Section>

		<Section id="availability" number={2} title="Availability">
			<p class="text-[15px] leading-relaxed text-foreground-2">
				railly.dev is a portfolio and discovery layer, not a hosted API product.
				Its read-only project catalog is documented by OpenAPI. It does not expose
				site-wide authentication, webhooks, or an MCP server. Follow each linked project's repository and documentation
				for its supported installation, interfaces, and usage.
			</p>
		</Section>
	</PageLayout>
</Layout>
