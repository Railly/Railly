---
import PageLayout from "@/components/layout/PageLayout.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";

const title = "Grid drill";
const description =
	"An experiment: give every place on Earth a short code you can zoom into, one cell at a time, then test whether it helps an AI agent find places.";
const ogImage = ogUrl({ title, description, tag: "lab" });

// The six real steps from the world to the Obelisco in Buenos Aires.
const steps = [
	{ src: "/lab/grid-drill/steps/01.jpg", code: "C2.B2", size: "2,062 km" },
	{ src: "/lab/grid-drill/steps/02.jpg", code: "C2.B2.C2", size: "515 km" },
	{ src: "/lab/grid-drill/steps/03.jpg", code: "…C2.C3", size: "129 km" },
	{ src: "/lab/grid-drill/steps/04.jpg", code: "…C3.B2", size: "32 km" },
	{ src: "/lab/grid-drill/steps/05.jpg", code: "…B2.A4", size: "8 km" },
	{
		src: "/lab/grid-drill/steps/06.jpg",
		code: "…A4.A3.B4",
		size: "503 m",
	},
];

const metrics = [
	{ value: "29 m", label: "typical miss, AI alone" },
	{ value: "319 m", label: "typical miss, AI with the grid" },
	{ value: "600", label: "agent runs" },
	{ value: "74 → 29 m", label: "after fixing one number" },
];

const notes = [
	{
		label: "Idea",
		title: "A zip code for the whole world.",
		body: "goncy shared a prototype where letters split the map into a grid. It didn't work for people, because places next to each other got very different codes. I wondered if the same grid could help an AI agent point at a spot on a map.",
	},
	{
		label: "Build",
		title: "A grid tied to the world, not the screen.",
		body: "Each level splits a cell into 16. Places that are close share the start of their code, and at any level you can step to a neighbor instead of starting over. Drag, click or use the arrow keys.",
	},
	{
		label: "Test",
		title: "Find a red pin with nothing to search for.",
		body: "I dropped a red pin at a random spot near 50 cities. The agent drove a real browser and had to report where the pin was. Half the runs used the mouse wheel. The other half could jump into grid cells. Each pin ran three times.",
	},
	{
		label: "Result",
		title: "The plain browser won.",
		body: "With the grid, the agent took a few big jumps and stopped at city level. With the mouse wheel, it kept zooming in small steps and landed within 29 m. In an earlier, simpler test the grid had won, which is a good reason to test against the real thing.",
	},
	{
		label: "Lesson",
		title: "Better instructions beat a new tool.",
		body: "The biggest gain came from one wrong number in the agent's instructions. Once they said how much one scroll really zooms, the typical miss went from 74 m to 29 m.",
	},
];

const sources = [
	{
		label: "goncy's original prototype",
		href: "https://x.com/goncy/status/2118319749062906251",
	},
	{
		label: "Plus Codes, a similar idea from Google",
		href: "https://maps.google.com/pluscodes/",
	},
	{
		label: "Maidenhead locator system",
		href: "https://en.wikipedia.org/wiki/Maidenhead_Locator_System",
	},
];
---

<Layout title={`${title} | Lab | Railly Hugo`} description={description} image={ogImage}>
	<PageLayout class="flex flex-col gap-16">
		<section class="flex flex-col gap-4">
			<a href="/lab" class="font-mono text-xs uppercase tracking-wider text-foreground-3 hover:text-foreground">Lab · Experiment 001</a>
			<h1 class="max-w-2xl text-2xl font-medium leading-tight text-foreground sm:text-3xl">{title}</h1>
			<p class="font-mono text-xs text-foreground-3">Nov 2026 · Interactive map · Didn't ship</p>
			<p class="max-w-2xl font-serif text-xl leading-snug text-foreground">
				What if every place on Earth had a short code you could zoom into, one cell at a time? I built it in a day, then tested it with an AI agent over 600 runs.
			</p>
			<div class="flex flex-wrap gap-4 text-sm">
				<a href="/lab/grid-drill/demo.html" target="_blank" rel="noopener" class="text-foreground underline decoration-ui underline-offset-4 hover:decoration-foreground">Open the demo</a>
				<a href="#film" class="text-foreground underline decoration-ui underline-offset-4 hover:decoration-foreground">Watch it run</a>
			</div>
		</section>

		<section class="flex flex-col gap-3">
			<div id="demo-wrap" class="demo-wrap relative aspect-[16/10] w-full overflow-hidden rounded border border-ui bg-background-2">
				<iframe
					id="demo-frame"
					src="/lab/grid-drill/demo.html?embed"
					title="Grid drill demo"
					loading="lazy"
					allow="fullscreen"
					class="absolute inset-0 h-full w-full"
				></iframe>
				<button id="demo-close" type="button" class="demo-close absolute right-3 top-3 z-10 hidden rounded border border-ui bg-background px-2.5 py-1 font-mono text-xs text-foreground hover:bg-background-2">Close · Esc</button>
			</div>
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
				<p class="text-xs text-foreground-3">Click a cell, or type the one you see (<span class="font-mono">b</span> then <span class="font-mono">3</span>) to go one level deeper. Arrows move to a neighbor, Backspace goes up.</p>
				<button id="demo-full" type="button" class="font-mono text-xs text-foreground underline decoration-ui underline-offset-4 hover:decoration-foreground">Fullscreen ⤢</button>
			</div>
		</section>

		<section class="flex flex-col gap-4">
			<SectionHeader title="From the world to the Obelisco in six clicks" />
			<ol class="grid grid-cols-2 gap-3 sm:grid-cols-3">
				{steps.map((s, i) => (
					<li class="flex flex-col gap-1.5">
						<picture>
							<source type="image/webp" srcset={s.src.replace(/\.jpg$/, ".webp")} />
							<img src={s.src} alt={`Step ${i + 1}: cell ${s.code}`} width="480" height="360" loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded border border-ui object-cover" />
						</picture>
						<p class="font-mono text-[11px] text-foreground-3"><span class="text-foreground">{String(i + 1).padStart(2, "0")}</span> {s.code} · {s.size}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="flex flex-col gap-3">
			<div class="grid grid-cols-2 gap-px overflow-hidden rounded border border-ui bg-ui sm:grid-cols-4">
				{metrics.map((m) => (
					<div class="bg-background p-4">
						<p class="font-mono text-xl tabular-nums text-foreground">{m.value}</p>
						<p class="mt-1 text-xs text-foreground-3">{m.label}</p>
					</div>
				))}
			</div>
			<p class="text-xs text-foreground-3">Median miss over 50 random pins, three runs each. Measured on November 6, 2026.</p>
		</section>

		<section class="flex flex-col gap-8">
			{notes.map((n) => (
				<div class="grid gap-2 sm:grid-cols-[7rem_1fr]">
					<p class="font-mono text-xs uppercase tracking-wider text-foreground-3">{n.label}</p>
					<div>
						<h2 class="text-base font-medium text-foreground">{n.title}</h2>
						<p class="mt-1 max-w-2xl text-sm leading-relaxed text-foreground-2">{n.body}</p>
					</div>
				</div>
			))}
		</section>

		<section id="film" class="flex flex-col gap-3 scroll-mt-24">
			<SectionHeader title="Watch it run" />
			<video
				src="/lab/grid-drill/run.mp4"
				poster="/lab/grid-drill/run-poster.webp"
				muted
				loop
				playsinline
				controls
				preload="metadata"
				data-lab-loop
				class="aspect-[16/10] w-full rounded border border-ui bg-background-2"
			></video>
			<p class="text-xs text-foreground-3">The demo above, driven with real clicks from the world to the Obelisco and back. No sound.</p>
		</section>

		<section>
			<SectionHeader title="Sources" className="mb-3" />
			<ul class="flex flex-col gap-2 text-sm">
				{sources.map((s) => (
					<li><a href={s.href} target="_blank" rel="noopener noreferrer" class="text-foreground-2 underline decoration-ui underline-offset-4 hover:text-foreground">{s.label}</a></li>
				))}
			</ul>
		</section>
	</PageLayout>
</Layout>

<script>
	const still = matchMedia("(prefers-reduced-motion: reduce)");
	const io = new IntersectionObserver((entries) => {
		for (const { target, isIntersecting } of entries) {
			const v = target as HTMLVideoElement;
			if (isIntersecting && !still.matches) v.play().catch(() => {});
			else v.pause();
		}
	}, { threshold: 0.4 });
	for (const v of document.querySelectorAll<HTMLVideoElement>("video[data-lab-loop]")) io.observe(v);
</script>

<style>
	.demo-wrap.is-full {
		position: fixed;
		inset: 0;
		z-index: 70;
		aspect-ratio: auto;
		border: 0;
		border-radius: 0;
	}
	.demo-wrap.is-full .demo-close {
		display: block !important;
	}
</style>

<script>
	// Fullscreen for the demo: the button, the demo's own ⤢ button or "f" key, and ?fullscreen in the URL.
	function initDemo() {
		const wrap = document.getElementById("demo-wrap");
		const frame = document.getElementById("demo-frame") as HTMLIFrameElement | null;
		const openBtn = document.getElementById("demo-full");
		const closeBtn = document.getElementById("demo-close");
		if (!wrap || !frame || !openBtn || !closeBtn || wrap.dataset.ready) return;
		wrap.dataset.ready = "1";
		let native = false;

		const setParam = (on: boolean) => {
			const url = new URL(location.href);
			if (on) url.searchParams.set("fullscreen", "");
			else url.searchParams.delete("fullscreen");
			history.replaceState(history.state, "", url.toString().replace("fullscreen=", "fullscreen"));
		};
		const enter = (useNative: boolean) => {
			wrap.classList.add("is-full");
			document.documentElement.style.overflow = "hidden";
			setParam(true);
			native = false;
			if (useNative && wrap.requestFullscreen) {
				wrap.requestFullscreen().then(() => { native = true; }).catch(() => {});
			}
			frame.contentWindow?.focus();
		};
		const exit = () => {
			wrap.classList.remove("is-full");
			document.documentElement.style.overflow = "";
			setParam(false);
			if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
			native = false;
		};
		const toggle = () => (wrap.classList.contains("is-full") ? exit() : enter(true));

		openBtn.addEventListener("click", toggle);
		closeBtn.addEventListener("click", exit);
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && wrap.classList.contains("is-full")) exit();
		});
		window.addEventListener("message", (e) => {
			if (e.source !== frame.contentWindow) return;
			if (e.data?.gridDrill === "toggle-fullscreen") toggle();
			if (e.data?.gridDrill === "exit-fullscreen" && wrap.classList.contains("is-full")) exit();
		});
		document.addEventListener("fullscreenchange", () => {
			if (!document.fullscreenElement && native) exit();
		});
		if (new URLSearchParams(location.search).has("fullscreen")) enter(false);
	}
	document.addEventListener("astro:page-load", initDemo);
	initDemo();
</script>
