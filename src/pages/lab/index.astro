---
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import LabCard from "@/components/home/LabCard.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { ogUrl } from "@/config/site";
import { labExperiments } from "@/data/lab";
import Layout from "@/layouts/Layout.astro";

const description = "Experiments in interfaces for people and AI agents.";
const ogImage = ogUrl({ title: "Lab", description, tag: "lab" });

const experiments = labExperiments;
---

<Layout title="Lab | Railly Hugo" description={description} image={ogImage}>
	<PageLayout class="flex flex-col">
		<PageHero eyebrow={["Lab", `${experiments.length} ${experiments.length === 1 ? "experiment" : "experiments"}`]}>
			<h1 data-ink-hero data-ink="interfaces,agents" class="ed-display">
				Experiments in interfaces for people and agents.
			</h1>
		</PageHero>

		<Section id="h-experiments" number={1} title="Experiments" class="mt-16">
			<div class="flex flex-col gap-10">
				{experiments.map((e) => (
					<LabCard href={e.href} title={e.title} summary={e.summary} meta={`${e.n} · ${e.date} · ${e.status}`} video={e.video} poster={e.poster} />
				))}
			</div>
		</Section>
	</PageLayout>
</Layout>

<script>
	// Loops play only while on screen, and never for reduced motion (the poster stays).
	const still = matchMedia("(prefers-reduced-motion: reduce)");
	const io = new IntersectionObserver((entries) => {
		for (const { target, isIntersecting } of entries) {
			const v = target as HTMLVideoElement;
			if (isIntersecting && !still.matches) v.play().catch(() => {});
			else v.pause();
		}
	}, { threshold: 0.25 });
	for (const v of document.querySelectorAll<HTMLVideoElement>("video[data-lab-loop]")) io.observe(v);
</script>
