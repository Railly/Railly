---
import PageLayout from "@/components/layout/PageLayout.astro";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";

const description = "Experiments in interfaces for people and AI agents.";
const ogImage = ogUrl({ title: "Lab", description, tag: "lab" });

const experiments = [
	{
		n: "001",
		href: "/lab/grid-drill",
		title: "Grid drill",
		summary:
			"A short code for every place on Earth, one cell at a time. An AI agent did better without it.",
		date: "Nov 2026",
		status: "Didn't ship",
		poster: "/lab/grid-drill/run-card-poster.webp",
		video: "/lab/grid-drill/run-card.mp4",
	},
];
---

<Layout title="Lab | Railly Hugo" description={description} image={ogImage}>
	<PageLayout class="flex flex-col gap-12">
		<section class="flex flex-col gap-4">
			<p class="font-mono text-xs uppercase tracking-wider text-foreground-3">Lab</p>
			<h1 class="max-w-2xl font-serif text-2xl leading-snug text-foreground sm:text-3xl">
				Experiments in interfaces for people and agents.
			</h1>
		</section>

		<ul class="flex flex-col">
			{experiments.map((e) => (
				<li class="border-t border-ui last:border-b">
					<a href={e.href} class="group grid gap-5 py-6 sm:grid-cols-[minmax(0,26rem)_1fr] sm:items-center sm:gap-8">
						<div class="relative aspect-[16/10] w-full overflow-hidden rounded border border-ui bg-background-2">
							<video src={e.video} poster={e.poster} muted loop playsinline preload="metadata" data-lab-loop aria-hidden="true" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"></video>
						</div>
						<div class="flex flex-col gap-1.5">
							<p class="font-mono text-xs text-foreground-3">{e.n} · {e.date} · {e.status}</p>
							<h2 class="text-lg font-medium text-foreground group-hover:underline group-hover:decoration-ui group-hover:underline-offset-4">{e.title}</h2>
							<p class="max-w-xl text-sm leading-relaxed text-foreground-2">{e.summary}</p>
							<p class="mt-2 font-mono text-xs text-foreground-3 transition-colors group-hover:text-foreground">Read the experiment →</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</PageLayout>
</Layout>

<script>
	// Loops play only while on screen, and never for reduced motion (the poster stays).
	const still = matchMedia("(prefers-reduced-motion: reduce)");
	const io = new IntersectionObserver((entries) => {
		for (const { target, isIntersecting } of entries) {
			const v = target as HTMLVideoElement;
			if (isIntersecting && !still.matches) v.play().catch(() => {});
			else v.pause();
		}
	}, { threshold: 0.25 });
	for (const v of document.querySelectorAll<HTMLVideoElement>("video[data-lab-loop]")) io.observe(v);
</script>
