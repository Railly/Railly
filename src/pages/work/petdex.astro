---
import Button from "@/components/editorial/Button.astro";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import Timeline from "@/components/editorial/Timeline.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import LinkedStats from "@/components/press/LinkedStats.astro";
import Layout from "@/layouts/Layout.astro";

const title = "Petdex: from a one-day build to a dependency of Hermes Agent";
const description =
	"How Petdex went from idea to live product in a day, and how it spread to 4,000+ stars, 78,000+ npm downloads and Hermes Agent.";
const ogImage = `/api/og?title=${encodeURIComponent("Petdex")}&description=${encodeURIComponent(description)}&tag=work`;

const metrics = [
	{
		value: "4,261",
		label: "GitHub stars",
		href: "https://github.com/crafter-station/petdex",
	},
	{
		value: "78,180",
		label: "npm downloads",
		href: "https://www.npmjs.com/package/petdex",
	},
	{ value: "5,087", label: "pets in the catalog", href: "https://petdex.dev" },
	{
		value: "96.7%",
		label: "of Crafter Station's Q2 star growth",
		href: "/press/petdex-impact",
	},
];

const steps = [
	{
		label: "Idea",
		title: "Coding agents had no personality layer.",
		body: "Codex, Claude Code and Gemini CLI all run in a terminal for hours. I wanted a small animated companion that sits next to the agent, and a shared place where anyone could publish one.",
	},
	{
		label: "Build",
		title: "Idea to live product in one day.",
		body: "The first day shipped the gallery, a CLI (npx petdex install <slug>), sign in with OAuth and PKCE, R2 storage and an agent skill so agents could install pets themselves. That day brought 1,797 visitors and 46 community pets.",
	},
	{
		label: "Design",
		title: "A public manifest instead of a closed app.",
		body: "Every pet is described in one public manifest. Agents and other tools can read it without asking for permission, which is what later made the integrations possible.",
	},
	{
		label: "Distribution",
		title: "Other projects started depending on it.",
		body: "Hermes Agent by Nous Research reads the Petdex manifest directly in its pet code path. Decrypt covered it and cited Petdex as the source of more than 3,200 sprites. A desktop app followed for macOS, Windows and Linux.",
	},
];

const sources = [
	{
		label: "Hermes Agent manifest consumer",
		href: "https://github.com/NousResearch/hermes-agent/blob/main/agent/pet/manifest.py",
	},
	{
		label: "Decrypt coverage",
		href: "https://decrypt.co/es/372082/tu-agente-hermes-ahora-tiene-una-mascota-que-no-hace-absolutamente-nada-y-ese-es-el-punto",
	},
	{ label: "Q2 2026 impact report", href: "/press/petdex-impact" },
	{
		label: "Contributors",
		href: "https://github.com/crafter-station/petdex/graphs/contributors",
	},
];
---

<Layout title={`${title} | Railly Hugo`} description={description} image={ogImage}>
	<PageLayout class="flex flex-col">
		<PageHero
			eyebrow={["Case study", "Petdex"]}
			title={title}
			lede="Petdex is an open gallery of animated pets for coding agents. I created it and remain its main contributor."
		>
			<div class="flex flex-wrap gap-3">
				<Button href="https://petdex.dev" variant="primary" external>Open Petdex</Button>
				<Button href="https://github.com/crafter-station/petdex" external>View source</Button>
			</div>
		</PageHero>

		<div aria-hidden="true" class="ed-art pets mt-12 flex aspect-[21/8] items-end justify-center gap-[4%] bg-[var(--ed-wash)] pb-[3%]">
			<span class="sprite" style="background-image:url(/images/petdex/boba.webp)"></span>
			<span class="sprite" style="background-image:url(/images/petdex/bee-teemo.webp)"></span>
			<span class="sprite" style="background-image:url(/images/petdex/aurelion-sol.webp)"></span>
		</div>

		<div class="ed mt-12 flex flex-col gap-3">
			<LinkedStats cols={4} stats={metrics} />
			<p class="ed-label">Figures checked on October 20, 2026.</p>
		</div>

		<Timeline label="How Petdex grew" class="mt-16" steps={steps.map((s) => ({ when: s.label, title: s.title, description: s.body }))} />

		<Section id="h-sources" number={1} title="Sources">
			<List>
				{sources.map((s) => (
					<ListRow dense href={s.href} external={s.href.startsWith("http")} title={s.label} />
				))}
			</List>
		</Section>
	</PageLayout>
</Layout>

<style>
	/* Petdex previews are 6-frame strips: play them as an idle loop. */
	.sprite {
		width: 15%;
		aspect-ratio: 192 / 208;
		background-size: 600% 100%;
		image-rendering: pixelated;
		animation: idle 0.9s steps(6) infinite;
	}
	.sprite:nth-child(2) {
		width: 19%;
		animation-delay: -0.3s;
	}
	.sprite:nth-child(3) {
		animation-delay: -0.6s;
	}
	@keyframes idle {
		from {
			background-position: 0 0;
		}
		to {
			background-position: 120% 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sprite {
			animation: none;
		}
	}
</style>
