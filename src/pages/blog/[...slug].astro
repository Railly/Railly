---
import { type CollectionEntry, getCollection } from "astro:content";
import ArticleGrid from "@/components/blog/ArticleGrid.astro";
import ArticleHeader from "@/components/blog/ArticleHeader.astro";
import ArticleProse from "@/components/blog/ArticleProse.astro";
import ClapButton from "@/components/blog/ClapButton";
import ViewCounter from "@/components/blog/ViewCounter";
import Link from "@/components/content/Link.astro";
import Quote from "@/components/content/Quote.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import Tile from "@/components/editorial/Tile.astro";
import Navigation from "@/components/layout/Navigation.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import AsciiField from "@/components/scene/AsciiField.astro";
import ArrowIcon from "@/components/ui/ArrowIcon.astro";
import InkReveal from "@/components/ui/InkReveal.astro";
import { isPostVisible } from "@/config/blog";
import { getReadingTime } from "@/config/reading-time";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => {
		return import.meta.env.PROD ? isPostVisible(data) : true;
	});
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection("blog", ({ data }) => {
	return isPostVisible(data);
});
const sortedPosts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const totalPosts = sortedPosts.length;

const previousPost =
	currentIndex < totalPosts - 1
		? sortedPosts[currentIndex + 1]
		: sortedPosts[0];
const nextPost =
	currentIndex > 0
		? sortedPosts[currentIndex - 1]
		: sortedPosts[totalPosts - 1];

const publishedDate = post.data.pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const updatedDate = post.data.updatedDate
	? post.data.updatedDate.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;

const ogDate = post.data.pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "short",
	day: "numeric",
});
const ogImage = `/api/og?title=${encodeURIComponent(post.data.title)}&description=${encodeURIComponent(post.data.description || "")}&tag=blog&date=${encodeURIComponent(ogDate)}`;

const {
	words,
	minutes,
	text: readingTimeText,
} = getReadingTime(post.body || "");
---

<Layout
    title={post.data.title}
    description={post.data.description}
    image={ogImage}
    article={true}
    publishedTime={post.data.pubDate}
    modifiedTime={post.data.updatedDate}
    readingTimeMinutes={minutes}
    wordCount={words}
>
    <AsciiField clear={560} />
    <Navigation />
    <div class="relative z-[1] w-full pt-12 pb-16 sm:pt-20">
        <ArticleGrid>
            <TableOfContents slot="aside" headings={headings} />

            <ArticleHeader
                eyebrow={[
                    { text: publishedDate, datetime: post.data.pubDate.toISOString() },
                    ...(updatedDate ? [`Updated ${updatedDate}`] : []),
                    { text: readingTimeText, title: `${words.toLocaleString()} words` },
                ]}
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags?.slice(0, 3)}
                transitionName={`blog-card-${post.slug}`}
                ink
            >
                <ViewCounter slot="meta" slug={post.slug} increment={true} separator=" · " className="" client:only="react" />
                <InkReveal slot="after-title" />
            </ArticleHeader>

            {
                post.data.heroImage && (
                    <div class="mb-12" transition:name={`blog-hero-${post.slug}`} transition:animate="fade">
                        <div class="ed-tile relative aspect-[2/1] w-full overflow-hidden bg-background-2">
                            <img src={post.data.heroImage.src} alt={post.data.heroImage.alt} class="h-full w-full object-cover" />
                        </div>
                    </div>
                )
            }

            <article class="blog-content">
                <ArticleProse>
                    <Content components={{ blockquote: Quote, a: Link }} />
                </ArticleProse>
            </article>

            <div class="mt-16 flex justify-center">
                <ClapButton slug={post.slug} client:only="react" />
            </div>

            <nav aria-label="More writing" class="ed mt-16 grid grid-cols-1 gap-4 md:grid-cols-2">
                <Tile href={`/blog/${previousPost.slug}`} class="group flex flex-col gap-2 p-4">
                    <span class="ed-label flex items-center gap-1">
                        <ArrowIcon size={12} class="rotate-180" />
                        Previous
                    </span>
                    <span class="line-clamp-2 text-[14.5px] leading-snug font-medium text-foreground">
                        {previousPost.data.title}
                    </span>
                </Tile>
                <Tile href={`/blog/${nextPost.slug}`} class="group flex flex-col gap-2 p-4 md:items-end md:text-right">
                    <span class="ed-label flex items-center gap-1">
                        Next
                        <ArrowIcon size={12} />
                    </span>
                    <span class="line-clamp-2 text-[14.5px] leading-snug font-medium text-foreground">
                        {nextPost.data.title}
                    </span>
                </Tile>
            </nav>
        </ArticleGrid>
    </div>

    <style>
        :target {
            scroll-margin-top: 2.5rem;
        }
    </style>
    <div class="relative z-[1] mx-auto max-w-[42rem] px-6 pb-16"><SiteFooter /></div>
</Layout>
