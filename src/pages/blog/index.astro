---
import { getCollection } from "astro:content";
import PostList from "@/components/blog/PostList.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { isPostListable } from "@/config/blog";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";

const posts = await getCollection("blog", ({ data }) => {
	return import.meta.env.PROD ? isPostListable(data) : true;
});

const sortedPosts = posts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsByYear = sortedPosts.reduce(
	(acc, post) => {
		const year = post.data.pubDate.getFullYear();
		if (!acc[year]) acc[year] = [];
		acc[year].push(post);
		return acc;
	},
	{} as Record<number, typeof sortedPosts>,
);

const years = Object.keys(postsByYear)
	.map(Number)
	.sort((a, b) => b - a);

const newestPost = sortedPosts[0];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const eyebrow = [
	plural(sortedPosts.length, "post"),
	years.length > 1
		? `${years[years.length - 1]} – ${years[0]}`
		: String(years[0] ?? ""),
].filter(Boolean);
---

<Layout
    image={ogUrl({ title: "Writing", description: "Technical articles on agents, developer tools and building in public.", tag: "writing" })}
    title="Blog - Railly Hugo"
    description="Technical articles, tutorials, and thoughts on web development, AI, and building in public."
>
    <PageLayout class="flex flex-col">
        <PageHero eyebrow={eyebrow} title="Writing" />

        {
            years.map((year, i) => (
                <Section
                    id={`h-${year}`}
                    number={i + 1}
                    title={String(year)}
                    note={plural(postsByYear[year].length, "post")}
                    class={i === 0 ? "mt-16" : "mt-14"}
                >
                    <PostList posts={postsByYear[year]} newestSlug={newestPost?.slug} readingTime />
                </Section>
            ))
        }
    </PageLayout>
</Layout>
