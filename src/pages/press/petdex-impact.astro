---
import Button from "@/components/editorial/Button.astro";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import StatStrip from "@/components/editorial/StatStrip.astro";
import Tile from "@/components/editorial/Tile.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import ProofSection from "@/components/press/ProofSection.astro";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";

const weekly = [
	["Apr 26–May 2", 380, 380],
	["May 3–9", 6641, 6261],
	["May 10–16", 11919, 5278],
	["May 17–23", 15001, 3082],
	["May 24–30", 18730, 3729],
	["May 31–Jun 6", 20733, 2003],
	["Jun 7–13", 23022, 2289],
	["Jun 14–20", 25043, 2021],
	["Jun 21–27", 27091, 2048],
	["Jun 28–Jul 4", 28875, 1784],
] as const;

const maxDownloads = 30000;
const points = weekly.map(([, total], index) => {
	const x = 24 + (index / (weekly.length - 1)) * 652;
	const y = 196 - (total / maxDownloads) * 156;
	return { x, y };
});
const line = points.map((point) => `${point.x},${point.y}`).join(" ");

const sources = [
	["OSSCAR Crafter Station profile", "https://osscar.dev/org/crafter-station"],
	["OSSCAR methodology", "https://osscar.dev/methodology"],
	[
		"npm public API, Petdex Q2 range",
		"https://api.npmjs.org/downloads/range/2026-04-26:2026-07-04/petdex",
	],
	[
		"Petdex contributors API",
		"https://api.github.com/repos/crafter-station/petdex/contributors?per_page=100",
	],
	[
		"Hermes manifest consumer",
		"https://github.com/NousResearch/hermes-agent/blob/main/agent/pet/manifest.py",
	],
	[
		"Decrypt coverage",
		"https://decrypt.co/es/372082/tu-agente-hermes-ahora-tiene-una-mascota-que-no-hace-absolutamente-nada-y-ese-es-el-punto",
	],
];
const attribution = [
	{
		repo: "crafter-station/petdex",
		start: "70",
		end: "3,288",
		net: "3,218",
		share: "96.72%",
	},
	{
		repo: "Crafter Station total",
		start: "870",
		end: "4,197",
		net: "3,327",
		share: "100%",
	},
];

const ratios = [
	{ value: "76×", detail: "Actual growth from the first 380-download bucket." },
	{
		value: "28.9×",
		detail: "OSSCAR ranking multiplier using a padded 1,000-download baseline.",
	},
	{
		value: "100%",
		detail:
			"Of Crafter Station's published OSSCAR npm signal came from Petdex.",
	},
];
---

<Layout
	image={ogUrl({ title: "One package drove Crafter Station’s Q2 open-source growth.", description: "Petdex: 28,875 npm downloads and 3,218 net new GitHub stars in Q2 2026.", tag: "press" })}
	title="Petdex Impact Report · Q2 2026 | Railly Hugo"
	description="A source-linked report on Petdex's 28,875 npm downloads, 3,218 net new GitHub stars, and contribution to Crafter Station's Q2 2026 growth."
>
	<PageLayout class="flex flex-col">
		<PageHero
			eyebrow={["Petdex Impact Report", "Q2 2026"]}
			title="One package drove Crafter Station's Q2 open-source growth."
			lede="Petdex generated 28,875 npm downloads and 3,218 net new GitHub stars during OSSCAR's published Q2 measurement window."
		>
			<StatStrip
				class="mt-2"
				stats={[
					{ label: "npm downloads", value: "28,875" },
					{ label: "net new stars", value: "3,218" },
					{ label: "of org star growth", value: "96.72%" },
				]}
			/>
			<Tile class="bg-[var(--ed-wash)] px-5 py-4 text-[14px] leading-relaxed text-foreground-2">
				OSSCAR's npm series matches the public npm API for <strong class="font-mono text-[13px] font-medium text-foreground">petdex</strong> point for point.
			</Tile>
			<p class="ed-label flex flex-wrap justify-between gap-x-4 gap-y-1">
				<span>Historical window: Apr 26–Jul 4, 2026</span>
				<span>Report updated: Aug 2, 2026</span>
			</p>
		</PageHero>

		<ProofSection id="h-proof-1" eyebrow={["Proof 01", "GitHub attribution"]} title="Petdex supplied 96.72% of Crafter Station's net new stars." class="mt-16">
			<p class="text-[15px] leading-relaxed text-foreground-2">Crafter Station grew from 870 to 4,197 stars, a gain of 3,327. Petdex grew from 70 to 3,288 stars in the same snapshot, a gain of 3,218.</p>
			<div class="flex flex-col sm:hidden">
				{attribution.map((r, i) => (
					<div class="border-t border-[var(--ed-line)] py-4 last:border-b">
						<p class:list={["font-mono text-[12px]", i > 0 && "text-foreground-2"]}>{r.repo}</p>
						<dl class="mt-3 grid grid-cols-4 gap-2">
							{[["Start", r.start], ["End", r.end], ["Net new", r.net], ["Share", r.share]].map(([k, v]) => (
								<div><dt class="ed-label">{k}</dt><dd class="ed-num mt-1 text-foreground">{v}</dd></div>
							))}
						</dl>
					</div>
				))}
			</div>
			<div class="hidden sm:block">
				<table class="report-table w-full text-left">
					<thead><tr><th class="ed-label">Repository</th><th class="ed-label text-right">Start</th><th class="ed-label text-right">End</th><th class="ed-label text-right">Net new</th><th class="ed-label text-right">Share</th></tr></thead>
					<tbody>
						{attribution.map((r, i) => (
							<tr class:list={[i > 0 && "text-foreground-2"]}><td class="font-mono text-[12.5px]">{r.repo}</td><td class="ed-num text-right">{r.start}</td><td class="ed-num text-right">{r.end}</td><td class="ed-num text-right">{r.net}</td><td class="ed-num text-right">{r.share}</td></tr>
						))}
					</tbody>
				</table>
			</div>
		</ProofSection>

		<ProofSection id="h-proof-2" eyebrow={["Proof 02", "The npm curve"]} title="From 380 to 28,875 downloads in ten weekly buckets.">
			<p class="text-[15px] leading-relaxed text-foreground-2">The values below are cumulative totals reconstructed from the npm public API across the same range shown by OSSCAR.</p>
			<figure class="ed-art bg-background p-3 sm:p-5">
				<svg viewBox="0 0 700 220" class="h-auto w-full" role="img" aria-labelledby="npm-chart-title npm-chart-desc">
					<title id="npm-chart-title">Petdex weekly cumulative npm downloads</title>
					<desc id="npm-chart-desc">Downloads increased from 380 in the first bucket to 28,875 by July 4, 2026.</desc>
					{[0, 10000, 20000, 30000].map((tick) => {
						const y = 196 - (tick / maxDownloads) * 156;
						return <g><line x1="24" x2="676" y1={y} y2={y} stroke="var(--ed-line-2)" stroke-width="1" stroke-dasharray={tick === 0 ? undefined : "2 4"} /><text x="24" y={y - 7} fill="var(--color-foreground-3)" class="font-mono text-[10px]">{tick.toLocaleString()}</text></g>;
					})}
					<polyline points={`24,196 ${line} 676,196`} fill="var(--ed-wash)" stroke="none" />
					<polyline points={line} fill="none" stroke="var(--color-foreground)" stroke-width="2" stroke-linejoin="round" />
					{points.map((point, index) => <g><circle cx={point.x} cy={point.y} r="3" fill="var(--color-background)" stroke="var(--color-foreground)" stroke-width="2" /><text x={point.x} y="216" text-anchor={index === 0 ? "start" : index === points.length - 1 ? "end" : "middle"} fill="var(--color-foreground-3)" class="font-mono text-[9px]">{index === 0 ? "May 2" : index === points.length - 1 ? "Jul 4" : ""}</text></g>)}
				</svg>
			</figure>
			<dl class="report-ratios grid border-y border-[var(--ed-line)]">
				{ratios.map((r) => (
					<div class="flex flex-col gap-1.5 py-4">
						<dt class="order-2 text-[13px] leading-relaxed text-foreground-3">{r.detail}</dt>
						<dd class="order-1 font-serif text-[28px] leading-none tabular-nums">{r.value}</dd>
					</div>
				))}
			</dl>
			<details class="ed-tile group bg-background">
				<summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[14px] font-medium [&::-webkit-details-marker]:hidden">
					Weekly breakdown
					<span aria-hidden="true" class="ed-label transition-transform group-open:rotate-180">&darr;</span>
				</summary>
				<div class="overflow-x-auto border-t border-[var(--ed-line)] px-4 pb-2">
					<table class="report-table w-full min-w-[18rem]">
						<thead><tr><th class="ed-label text-left">Bucket</th><th class="ed-label text-right">Weekly</th><th class="ed-label text-right">Cumulative</th></tr></thead>
						<tbody>{weekly.map(([period, total, delta]) => <tr><td class="text-[13px]">{period}</td><td class="ed-num text-right">{delta.toLocaleString()}</td><td class="ed-num text-right text-foreground">{total.toLocaleString()}</td></tr>)}</tbody>
					</table>
				</div>
			</details>
		</ProofSection>

		<ProofSection id="h-proof-3" eyebrow={["Proof 03", "Personal attribution"]}>
			<div class="report-attribution grid gap-6 border-y border-[var(--ed-line)] py-6">
				<div class="flex flex-col gap-2">
					<p class="font-serif text-[64px] leading-none tabular-nums">612</p>
					<p class="text-[14px] leading-relaxed text-foreground-2">Petdex contributions by Railly Hugo in the captured GitHub contributor snapshot.</p>
				</div>
				<p class="font-serif text-[20px] leading-[1.45]">The second contributor recorded 67 contributions. Railly's count was 9.13 times higher, supporting the description <em>principal creator</em> without claiming he built the project alone.</p>
			</div>
		</ProofSection>

		<ProofSection id="h-proof-4" eyebrow={["Proof 04", "Independent use"]} title="Hermes consumes Petdex in an actual code path.">
			<p class="text-[15px] leading-relaxed text-foreground-2">Hermes Agent's official code fetches Petdex's public manifest and asset URLs. Its documentation directs users to the Petdex gallery, and Decrypt independently identified Petdex as the sprite source in its coverage. This is adoption evidence, not a formal partnership claim.</p>
		</ProofSection>

		<Section id="h-method" title="Methodology and sources">
			<p class="text-[14.5px] leading-relaxed text-foreground-2">This report preserves OSSCAR's historical Q2 snapshot. GitHub stars measure attention, not users or revenue. npm downloads count registry downloads, not unique people. The 96.72% figure applies only to net new stars. The 100% npm figure applies only to Crafter Station's published OSSCAR npm series for this measurement window.</p>
			<List>
				{sources.map(([label, href], i) => <ListRow dense href={href} external index={String(i + 1).padStart(2, "0")} title={label} />)}
			</List>
		</Section>

		<Tile class="mt-16 flex flex-col gap-5 bg-[var(--ed-wash)] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
			<div class="flex flex-col gap-1">
				<p class="font-serif text-[22px] leading-snug">Press, legal, or research questions</p>
				<p class="text-[14px] text-foreground-2">Request the dated evidence package or a source walkthrough.</p>
			</div>
			<Button href="mailto:hi@railly.dev?subject=Petdex%20Impact%20Report" variant="primary" class="shrink-0">hi@railly.dev</Button>
		</Tile>
	</PageLayout>
</Layout>

<style>
	.report-table :global(th) {
		padding-block: 0.75rem;
		font-weight: 400;
	}
	.report-table :global(td) {
		padding-block: 0.7rem;
		border-top: 1px solid var(--ed-line);
	}
	.report-table {
		border-bottom: 1px solid var(--ed-line);
	}
	details .report-table {
		border-bottom: 0;
	}
	.report-ratios > :not(:first-child) {
		border-top: 1px solid var(--ed-line);
	}
	@media (min-width: 40rem) {
		.report-ratios {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.report-ratios > :not(:first-child) {
			border-top: 0;
			border-left: 1px solid var(--ed-line);
			padding-left: 1rem;
		}
		.report-ratios > :not(:last-child) {
			padding-right: 1rem;
		}
		.report-attribution {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
			align-items: end;
		}
	}
</style>
