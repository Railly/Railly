---
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import StatStrip from "@/components/editorial/StatStrip.astro";
import Tile from "@/components/editorial/Tile.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { NextSteps } from "@/components/mentoring/NextSteps";
import { TestimonialForm } from "@/components/mentoring/TestimonialForm";
import Layout from "@/layouts/Layout.astro";
import "@/components/mentoring/mentoring.css";

// Mockup: static data until the claim flow exists.
const session = {
	mentee: "Anna Albirena",
	date: "October 31, 2026",
	duration: "35 min",
	tier: "Deep session",
	nextSteps: [
		"Convert the Word minutes to Markdown in SharePoint",
		"Write the team's inadmissible list for prototypes",
		"Audit the architecture team's site against your components",
	],
};

const files = [
	{
		title: "Mentoring report",
		detail: "3 pages · PDF",
		href: "#download-report",
		kind: "PDF",
	},
	{
		title: "Full transcript",
		detail: "13 pages · PDF",
		href: "#download-transcript",
		kind: "PDF",
	},
	{
		title: "The Playbook",
		detail: "12 chapters · web + PDF",
		href: "#playbook",
		kind: "WEB",
	},
	{
		title: "Mentor skill",
		detail: "Claude Code skill or Claude project files",
		href: "#skill",
		kind: "SKILL",
	},
];

const meta = [
	{ label: "Mentee", value: session.mentee },
	{ label: "Date", value: session.date },
	{ label: "Length", value: session.duration },
	{ label: "Plan", value: session.tier },
];

const firstName = session.mentee.split(" ")[0];
---

<Layout title="Your mentoring report — Railly Hugo" description="Your mentoring files.">
	<PageLayout class="flex flex-col">
		<PageHero
			class="gap-5"
			eyebrow={`Your session · ${session.date}`}
			title={`Thanks for the talk, ${firstName}.`}
			lede="Everything from our session is below. Download what you need, keep the next steps close, and come back to them on day 30."
		>
			<StatStrip variant="text" stats={meta} />
		</PageHero>

		<Section id="h-files" number={1} title="Your files" note="Yours to keep. No form required." class="mt-16">
			<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				{
					files.map((f) => (
						<li>
							<Tile href={f.href} class="group flex h-full items-center gap-4 p-4">
								<span aria-hidden="true" class="ed-art relative flex h-14 w-11 shrink-0 items-end justify-center bg-background-2 pb-1.5 [clip-path:polygon(0_0,72%_0,100%_22%,100%_100%,0_100%)]">
									<span class="font-mono text-[8.5px] font-semibold tracking-wider text-foreground-2">{f.kind}</span>
								</span>
								<span class="flex min-w-0 flex-1 flex-col gap-0.5">
									<span class="text-[15px] font-medium">{f.title}</span>
									<span class="ed-label">{f.detail}</span>
								</span>
								<span aria-hidden="true" class="font-mono text-[15px] text-foreground-3 transition-[translate,color] group-hover:translate-y-0.5 group-hover:text-foreground">&darr;</span>
							</Tile>
						</li>
					))
				}
			</ul>
		</Section>

		<Section id="h-steps" number={2} title="Next steps" class="mt-16">
			<NextSteps client:visible steps={session.nextSteps} />
			<p class="ed-label">I'll check in on these on day 30.</p>
		</Section>

		<Section id="h-help" number={3} title="Did it help?" noteInline class="mt-16">
			<span slot="note" class="rounded-[3px] border border-[var(--ed-line-2)] px-1.5 py-px">Optional</span>
			<p class="-mt-3 text-[14.5px] leading-relaxed text-foreground-2">
				Your files are yours either way. If you leave a few words, I may show them on
				<a href="/mentoring" class="ed-link text-foreground">railly.dev/mentoring</a>.
			</p>
			<div class="ed-tile p-5 sm:p-6">
				<TestimonialForm client:visible mentee={session.mentee} />
			</div>
		</Section>
	</PageLayout>
</Layout>
