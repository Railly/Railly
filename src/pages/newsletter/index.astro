---
import { getCollection } from "astro:content";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import NewsletterSection from "@/components/newsletter/NewsletterSection.astro";
import Layout from "@/layouts/Layout.astro";

const ogTitle = "Newsletter";
const ogDescription =
	"Notes on what I’m building, learning, and figuring out. Read and subscribe on Substack.";
const ogImage = `/api/og?title=${encodeURIComponent(ogTitle)}&description=${encodeURIComponent(ogDescription)}&tag=newsletter`;

const issues = await getCollection("newsletter");
const sortedIssues = issues.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) => {
	const day = date.getDate().toString().padStart(2, "0");
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	return `${day}/${month}`;
};
---

<Layout
    title="Newsletter - Railly Hugo"
    description={ogDescription}
    image={ogImage}
>
    <PageLayout class="flex flex-col">
        <PageHero eyebrow={[`${sortedIssues.length} ${sortedIssues.length === 1 ? "edition" : "editions"}`, "On Substack"]} title="Newsletter">
            <NewsletterSection />
        </PageHero>

        {sortedIssues.length > 0 ? (
            <Section id="h-editions" number={1} title="Earlier editions" class="mt-16">
                <List>
                    {sortedIssues.map((issue) => (
                        <ListRow
                            href={`/newsletter/${issue.slug}`}
                            index={`#${issue.data.weekNumber}`}
                            title={issue.data.title}
                            meta={formatDate(issue.data.pubDate)}
                            arrow={false}
                        />
                    ))}
                </List>
            </Section>
        ) : null}
    </PageLayout>
</Layout>
