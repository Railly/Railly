---
import { type CollectionEntry, getCollection } from "astro:content";
import ArticleGrid from "@/components/blog/ArticleGrid.astro";
import ArticleHeader from "@/components/blog/ArticleHeader.astro";
import ArticleProse from "@/components/blog/ArticleProse.astro";
import Link from "@/components/content/Link.astro";
import Quote from "@/components/content/Quote.astro";
import Navigation from "@/components/layout/Navigation.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import AsciiField from "@/components/scene/AsciiField.astro";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
	const issues = await getCollection("newsletter");
	return issues.map((issue) => ({
		params: { slug: issue.slug },
		props: { issue },
	}));
}

interface Props {
	issue: CollectionEntry<"newsletter">;
}

const { issue } = Astro.props;
const { Content } = await issue.render();

const publishedDate = issue.data.pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const ogImage = `/api/og?title=${encodeURIComponent(issue.data.title)}&description=${encodeURIComponent(issue.data.subject)}&tag=newsletter`;
---

<Layout
    title={`${issue.data.title} - Newsletter`}
    description={issue.data.subject}
    image={ogImage}
>
    <AsciiField clear={400} />
    <Navigation />
    <div class="relative z-[1] w-full pt-12 pb-16 sm:pt-20">
        <ArticleGrid>
            <ArticleHeader
                eyebrow={[
                    { text: "Newsletter", href: "/newsletter" },
                    `#${issue.data.weekNumber}`,
                    { text: publishedDate, datetime: issue.data.pubDate.toISOString() },
                ]}
                title={issue.data.title}
            />

            <article>
                <ArticleProse>
                    <Content components={{ blockquote: Quote, a: Link }} />
                </ArticleProse>
            </article>

            <div class="mt-16 border-t border-[var(--ed-line)] pt-6">
                <a href="/newsletter" class="ed-label">&larr; All issues</a>
            </div>
        </ArticleGrid>
    </div>
    <div class="relative z-[1] mx-auto max-w-[42rem] px-6 pb-16"><SiteFooter /></div>
</Layout>
