---
import Button from "@/components/editorial/Button.astro";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import PullQuote from "@/components/editorial/PullQuote.astro";
import Section from "@/components/editorial/Section.astro";
import StatStrip from "@/components/editorial/StatStrip.astro";
import Timeline from "@/components/editorial/Timeline.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { Faq } from "@/components/mentoring/Faq";
import { Pricing } from "@/components/mentoring/Pricing";
import { TakeHome } from "@/components/mentoring/TakeHome";
import Layout from "@/layouts/Layout.astro";
import BrandIcon from "../components/brand/BrandIcon.astro";
import "@/components/mentoring/mentoring.css";

