		name: "Junior Rodriguez",
		context: "AI & Software Engineer @ Juan ADS",
		url: "https://junrod.notion.site/Junior-Rodriguez-Desarrollador-FullStack-1be599dff6b080dda3aae4ac7d6a0fe6",
