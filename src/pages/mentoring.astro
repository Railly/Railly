		cta: "Talk to me",
		href: "/contact",
		featured: false,
	},
];

const deliverables = [
	{
		title: "Report",
		detail: "Context, topics, recommendations, next steps, resources.",
		tag: "PDF",
	},
	{
		title: "Transcript",
		detail: "The whole conversation, corrected, so you can re-read it.",
		tag: "PDF",
	},
	{
		title: "The Playbook",
		detail: "Everything I tell mentees, written once. 12 chapters, updated.",
		tag: "Mentees only",
	},
	{
		title: "Mentor skill",
		detail:
			"An agent that knows my advice and your report. Works in Claude Code or a Claude project.",
		tag: "Mentees only",
	},
	{
		title: "Day-30 follow-up",
		detail: "I check in on your next steps a month later.",
		tag: "Message",
