const mentoringStats = {
	devsMentored: 25,
	sessionsThisWeek: 1,
	upcomingSessions: 0,
};

const reportPreview = {
	mentee: "Your Name",
	date: "March 2026",
	sections: [
		"Contexto",
		"Temas Principales",
		"Recomendaciones",
		"Próximos Pasos",
		"Recursos",
	],
};

const reportBlurb =
	"You get a personalized report with everything we discussed: context, key topics, concrete recommendations, next steps, and resources. Branded, structured, yours to keep.";

const steps = [
	{
		when: "Day 0",
		title: "Book",
		description:
			"Pick a session and pay. Regional pricing applies at checkout.",
	},
	{
		when: "Before we talk",
		title: "Prep form",
		description:
			"A few questions about where you are. I read it before the call.",
	},
	{
		when: "The session",
		title: "We talk",
		description: "One problem, properly. Spanish or English.",
	},
	{
		when: "After the call",
		title: "Report + transcript",
		description:
			"Both land in your inbox, with the Playbook and your mentor skill.",
	},
	{
		when: "Day 30",
		title: "Follow-up",
		description: "I check in on your next steps a month later.",
	},
];

const faq = [
	{
		q: "Is there still a free option?",
		a: "Yes. Office hours are free: 20 minutes, limited slots, for students, career changers and Crafter Station members. Join the waitlist on /meet.",
	},
	{
		q: "What is the mentor skill?",
		a: "An agent that knows my advice and your report. It works in Claude Code or a Claude project, so you can keep asking questions after we talk.",
	},
	{
		q: "What if it doesn't help?",
		a: "If the session didn't help, tell me and I refund it.",
	},
	{
		q: "Spanish or English?",
		a: "Both. We talk in whichever you're more comfortable with.",
	},
];

const pullQuote = testimonials.find((t) => t.name === "Valentin Rodriguez");

const ogTitle = "Mentoring";
const ogDescription =
	"1:1 mentoring with Railly Hugo on working with agents, remote careers, design engineering, and building in public. Free office hours and paid deep sessions, in Spanish or English.";
const ogImage = `/api/og?title=${encodeURIComponent(ogTitle)}&description=${encodeURIComponent(ogDescription)}&tag=mentoring`;
---

<Layout title={`${ogTitle} — Railly Hugo`} description={ogDescription} image={ogImage}>
	<PageLayout class="flex flex-col">
		<PageHero eyebrow="1:1 mentoring · Spanish or English · from $59" title="Mentoring">
			<Fragment slot="lede">
				Every week I talk with developers across Latin America. Most of them
				ask me the <a href="/blog/what-4-developers-asked-me" class="ed-link text-foreground">same three things</a>. I went from Lima with no connections to
				working remotely at <a href="https://vercel.com" target="_blank" class="ed-link text-foreground">Vercel Labs</a>, and I'm happy to share how.
			</Fragment>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
				<Button href="#options" variant="primary">See options <span aria-hidden="true">&darr;</span></Button>
				<span class="ed-label">From $59 · free office hours available</span>
			</div>
			<StatStrip
				stats={[
					{ label: "Devs mentored 1:1", value: mentoringStats.devsMentored },
					{ label: `${mentoringStats.sessionsThisWeek === 1 ? "Session" : "Sessions"} this week`, value: mentoringStats.sessionsThisWeek },
					{ label: "Upcoming", value: mentoringStats.upcomingSessions },
				]}
			/>
		</PageHero>

		{
			pullQuote && (
				<PullQuote
					class="mt-16"
					quote="I saved myself 2 months of Claude tokens in those 30 minutes of mentoring."
					name={pullQuote.name}
					context={pullQuote.context}
					image={pullQuote.image}
				/>
			)
		}

		<Section id="h-topics" number={1} title="What I help with">
			<List>
				{topics.map((topic, i) => <ListRow href={topic.href} index={`${String.fromCharCode(97 + i)}.`} title={topic.title} description={topic.description} />)}
			</List>
		</Section>

		<Section id="h-options" anchor="options" number={2} title="Ways to work together" class="scroll-mt-24">
			<Pricing client:visible tiers={tiers} />
		</Section>

		<Section id="h-home" number={3} title="What you take home">
			<TakeHome client:visible deliverables={deliverables} preview={reportPreview} reportBlurb={reportBlurb} />
		</Section>

		<Section id="h-how" number={4} title="How it works" class="gap-6">
			<Timeline label="How a paid session works" steps={steps} />
		</Section>

		<Section id="h-words" number={5} title="In their words" class="gap-2">
			<p class="ed-label">{testimonials.length} mentees, unedited. Hover to pause.</p>
			<div class="m-marquee relative left-1/2 w-[100vw] -translate-x-1/2 overflow-hidden py-6 [mask-image:linear-gradient(to_right,transparent,#000_6%,#000_94%,transparent)]">
				<ul class="m-marquee-track flex w-max items-stretch gap-5">
					{
						[...testimonials, ...testimonials, ...testimonials].map((t, i) => (
							<li
								aria-hidden={i >= testimonials.length ? "true" : undefined}
								class={`ed-tile flex w-[290px] shrink-0 flex-col bg-background p-5 sm:w-[380px] ${i % 2 === 0 ? "rotate-[0.4deg]" : "-rotate-[0.4deg]"}`}
							>
								<p class="flex-1 font-serif text-[15px] leading-relaxed text-foreground">&ldquo;{t.quote}&rdquo;</p>
								<div class="mt-4 flex items-center gap-2.5 border-t border-[var(--ed-line)] pt-3">
									<img src={t.image} alt="" class="size-8 rounded-full object-cover ring-1 ring-ui" loading="lazy" />
									<div class="flex min-w-0 flex-col">
										{t.url ? (
											<a href={t.url} target="_blank" tabindex={i >= testimonials.length ? -1 : undefined} class="ed-link w-fit text-[13px] font-medium text-foreground">{t.name}</a>
										) : (
											<span class="text-[13px] font-medium">{t.name}</span>
										)}
										<span class="ed-label truncate">{t.context}</span>
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</Section>

		<Section id="h-faq" number={6} title="Questions" class="mt-16">
			<Faq client:visible questions={faq} />
		</Section>

		<p class="mt-16 text-[14.5px] leading-relaxed text-foreground-3">
			Read the <a href="/blog/what-4-developers-asked-me" class="ed-link text-foreground">full blog post</a> behind these conversations, or join <BrandIcon
				name="crafterStation"
				width={14}
				height={14}
				class="inline-block mb-0.5 mr-1 align-text-bottom"
			/><a href="https://crafterstation.com" target="_blank" class="ed-link text-foreground">Crafter Station</a> to connect with 1,000+ builders in Peru.
		</p>
	</PageLayout>
</Layout>

<style is:global>
	html {
		overflow-x: clip;
	}
</style>
