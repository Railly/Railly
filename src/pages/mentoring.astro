		description: "Visibility over CVs",
		color: "purple",
		href: "/blog/what-4-developers-asked-me#how-do-i-get-visible",
	},
	{
		title: "Design Engineering",
		description: "Taste, references, design in code",
		color: "orange",
		href: "/blog/design-engineering",
	},
];

const tiers = [
	{
		name: "Office hours",
		price: "Free",
		regionalPrice: null,
		ppp: null,
		cadence: "20 min · limited slots",
		description: "For students, career changers and Crafter Station members.",
		includes: ["Short written summary", "One clear next step"],
		cta: "Join the waitlist",
		href: "/meet",
		featured: false,
	},
	{
		name: "Deep session",
		price: "$89",
		regionalPrice: "$59",
		ppp: "$59 in LATAM & Africa",
		cadence: "60 min · 1:1",
		description: "One problem, properly. I read your prep form before we talk.",
