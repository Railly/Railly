---
import { compact, homeData } from "@/components/variants/data";
import Layout from "@/layouts/Layout.astro";

const { projects, posts, appearances, achievements, videos } = await homeData();
const year = (d: Date) => d.getFullYear();
---

<Layout title="Railly Hugo (v4)" description="Variant 4">
	<main class="v4 mx-auto flex min-h-screen max-w-[44rem] flex-col px-6 pt-[18vh] pb-16 text-[#141414] dark:text-[#ececec]">
		<div class="text-[clamp(1.35rem,3.2vw,1.85rem)] leading-[1.55] tracking-[-0.018em]">
			<span>Railly Hugo is a Peruvian engineer at Vercel Labs who builds </span>
			<button class="t" aria-expanded="false" aria-controls="x-work" data-key="1">tools agents can use<sup>{projects.length}</sup></button><div class="x" id="x-work"><div>
				{projects.map((p) => (
					<a href={p.url} target="_blank" rel="noopener noreferrer" class="r">
						<span class="n">{p.name}</span><span class="d">{p.description}</span><span class="m">{p.stars >= 100 ? compact.format(p.stars) : ""}</span>
					</a>
				))}
			</div></div><span>, gives </span>
			<button class="t" aria-expanded="false" aria-controls="x-talks" data-key="2">talks<sup>{appearances.length}</sup></button><div class="x" id="x-talks"><div>
				{appearances.map((a) => (
					<a href={a.url} target="_blank" rel="noopener noreferrer" class="r">
						<span class="n">{a.title}</span><span class="d">{a.where}</span><span class="m">{a.date.slice(0, 4)}</span>
					</a>
				))}
			</div></div><span> about what is barely possible, runs </span>
			<button class="t" aria-expanded="false" aria-controls="x-cs" data-key="3">a community of 1,000+ builders<sup>{achievements.length}</sup></button><div class="x" id="x-cs"><div>
				<a href="https://github.com/crafter-station" target="_blank" rel="noopener noreferrer" class="r"><span class="n">Crafter Station</span><span class="d">Peru, since 2024. We ship together and win together.</span><span class="m"></span></a>
				{achievements.map((a) => (
					<a href={a.eventUrl} target="_blank" rel="noopener noreferrer" class="r">
						<span class="n">{a.achievement}</span><span class="d">{a.event}</span><span class="m">{a.year}</span>
					</a>
				))}
			</div></div><span>, and keeps </span>
			<button class="t" aria-expanded="false" aria-controls="x-notes" data-key="4">notes<sup>{posts.length + videos.length}</sup></button><div class="x" id="x-notes"><div>
				{posts.map((p) => (
					<a href={`/blog/${p.slug}`} class="r"><span class="n">{p.data.title}</span><span class="d">Essay</span><span class="m">{year(p.data.pubDate)}</span></a>
				))}
				{videos.map((v) => (
					<a href={v.url} target="_blank" rel="noopener noreferrer" class="r"><span class="n">{v.title}</span><span class="d">Video</span><span class="m"></span></a>
				))}
			</div></div><span> along the way.</span>
		</div>

		<footer class="mt-auto flex flex-wrap items-baseline justify-between gap-4 pt-24 text-[13px] text-black/45 dark:text-white/40">
			<button class="all transition-colors hover:text-current" type="button">Open everything</button>
			<span class="hidden sm:inline">Press 1 to 4</span>
			<span class="flex gap-4">
				<a href="https://github.com/railly" class="hover:text-current">GitHub</a>
				<a href="https://x.com/raillyhugo" class="hover:text-current">X</a>
				<a href="mailto:hi@railly.dev" class="hover:text-current">Email</a>
				<span class="tabular-nums">Buenos Aires <span data-clock>--:--</span></span>
			</span>
		</footer>
	</main>
</Layout>

<style>
	.t {
		cursor: pointer;
		color: inherit;
		text-decoration: underline dotted;
		text-decoration-color: color-mix(in oklab, currentColor 35%, transparent);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1.5px;
		transition: text-decoration-color 0.25s ease, opacity 0.25s ease;
	}
	.t:hover,
	.t[aria-expanded="true"] {
		text-decoration-color: currentColor;
	}
	.t:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
		border-radius: 2px;
	}
	.t sup {
		margin-left: 0.15em;
		font-size: 0.5em;
		font-variant-numeric: tabular-nums;
		opacity: 0.45;
		text-decoration: none;
		display: inline-block;
	}

	.x {
		display: none;
	}
	.x.open {
		display: block;
		margin: 0.9rem 0 1.1rem;
		animation: x-in 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	@keyframes x-in {
		from { opacity: 0; transform: translateY(-4px); }
	}

	.r {
		display: grid;
		grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) 3rem;
		gap: 1rem;
		align-items: baseline;
		padding: 0.5rem 0;
		font-size: 15px;
		line-height: 1.45;
		letter-spacing: 0;
		border-top: 1px solid color-mix(in oklab, currentColor 9%, transparent);
	}
	.x.open .r {
		animation: r-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i, 0) * 35ms);
	}
	@keyframes r-in {
		from { opacity: 0; transform: translateY(6px); filter: blur(3px); }
	}
	.r .d,
	.r .m {
		opacity: 0.5;
	}
	.r .m {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.r:hover .n {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}
	@media (max-width: 640px) {
		.r {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.r .d {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.x.open,
		.x.open .r {
			animation: none;
		}
	}
</style>

<script>
	const triggers = [...document.querySelectorAll<HTMLButtonElement>(".v4 .t")];
	const set = (t: HTMLButtonElement, open: boolean) => {
		const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
		t.setAttribute("aria-expanded", String(open));
		panel?.classList.toggle("open", open);
	};
	for (const t of triggers) {
		const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
		panel?.querySelectorAll<HTMLElement>(".r").forEach((r, i) => r.style.setProperty("--i", String(i)));
		t.addEventListener("click", () => set(t, t.getAttribute("aria-expanded") !== "true"));
	}
	const all = document.querySelector<HTMLButtonElement>(".v4 .all");
	all?.addEventListener("click", () => {
		const open = triggers.some((t) => t.getAttribute("aria-expanded") !== "true");
		for (const t of triggers) set(t, open);
		all.textContent = open ? "Close everything" : "Open everything";
	});
	window.addEventListener("keydown", (e) => {
		if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest("input,textarea")) return;
		const t = triggers.find((x) => x.dataset.key === e.key);
		if (t) set(t, t.getAttribute("aria-expanded") !== "true");
	});
	const clock = document.querySelector<HTMLElement>("[data-clock]");
	if (clock) {
		const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "America/Argentina/Buenos_Aires" });
		const tick = () => (clock.textContent = fmt.format(new Date()));
		tick();
		setInterval(tick, 15000);
	}
</script>
