---
import { compact, homeData } from "@/components/variants/data";
import Layout from "@/layouts/Layout.astro";

const { projects, posts, appearances } = await homeData();
const lines = [
	["Railly Hugo", 0],
	["is a Peruvian", 1],
	["engineer building", 0],
	["at the frontier of", 1],
	["agents and interfaces", 0],
	["at Vercel Labs", 1],
] as const;
---

<Layout title="Railly Hugo (v1)" description="Variant 1">
	<div class="v1 min-h-screen bg-[#ededeb] px-4 py-10 text-[#111] sm:px-10 dark:bg-[#0b0b0b] dark:text-[#ededed]">
		<nav class="mx-auto mb-10 flex max-w-[66rem] justify-between text-[13px] text-black/50 dark:text-white/40">
			<span>railly.dev</span>
			<span class="flex gap-5"><a href="/projects" class="hover:text-current">work</a><a href="/writing" class="hover:text-current">writing</a><a href="/about" class="hover:text-current">about</a></span>
		</nav>

		<section data-canvas class="relative mx-auto aspect-[4/5] max-w-[66rem] cursor-crosshair overflow-hidden bg-white sm:aspect-[5/3] dark:bg-[#151515]">
			<span data-disc class="pointer-events-none absolute top-1/2 left-[64%] size-[62%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d91023] mix-blend-multiply transition-[left,top] duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] sm:size-auto sm:h-full sm:aspect-square dark:mix-blend-screen"></span>
			<h1 class="relative flex h-full flex-col justify-center px-6 text-[clamp(2rem,6vw,4.4rem)] leading-[1.08] font-medium tracking-[-0.035em] sm:px-14">
				{lines.map(([t, indent]) => <span class:list={["block", indent && "pl-[1.1em]"]}>{t}</span>)}
			</h1>
		</section>

		<div class="mx-auto mt-16 grid max-w-[66rem] gap-12 text-[15px] sm:grid-cols-2">
			<section>
				<h2 class="mb-4 text-[13px] text-black/50 dark:text-white/40">Work</h2>
				{projects.map((p) => (
					<a href={p.url} target="_blank" class="group flex justify-between border-t border-black/10 py-3 dark:border-white/10">
						<span class="group-hover:text-[#d91023]">{p.name}</span>
						<span class="text-black/40 tabular-nums dark:text-white/40">{p.stars >= 100 ? compact.format(p.stars) : ""}</span>
					</a>
				))}
			</section>
			<section>
				<h2 class="mb-4 text-[13px] text-black/50 dark:text-white/40">Writing and talks</h2>
				{posts.map((p) => (
					<a href={`/blog/${p.slug}`} class="block border-t border-black/10 py-3 hover:text-[#d91023] dark:border-white/10">{p.data.title}</a>
				))}
				{appearances.slice(0, 3).map((a) => (
					<a href={a.url} target="_blank" class="flex justify-between border-t border-black/10 py-3 hover:text-[#d91023] dark:border-white/10">
						<span>{a.title}</span><span class="text-black/40 dark:text-white/40">{a.kind}</span>
					</a>
				))}
			</section>
		</div>
	</div>
</Layout>

<script>
	const canvas = document.querySelector<HTMLElement>("[data-canvas]");
	const disc = document.querySelector<HTMLElement>("[data-disc]");
	if (canvas && disc && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		canvas.addEventListener("pointermove", (e) => {
			const r = canvas.getBoundingClientRect();
			disc.style.left = `${((e.clientX - r.left) / r.width) * 100}%`;
			disc.style.top = `${((e.clientY - r.top) / r.height) * 100}%`;
		});
		canvas.addEventListener("pointerleave", () => {
			disc.style.left = "64%";
			disc.style.top = "50%";
		});
	}
</script>
