---
import { homeData } from "@/components/variants/data";
import Layout from "@/layouts/Layout.astro";

const { projects, posts, appearances } = await homeData();
let i = 0;
const d = () => `--d:${i++ * 60}ms`;
---

<Layout title="Railly Hugo (v2)" description="Variant 2">
	<main class="v2 mx-auto max-w-[40rem] px-6 py-24 text-[16px] leading-relaxed text-[#171717] dark:text-[#ededed]">
		<header class="in" style={d()}>
			<h1>Railly Hugo</h1>
			<p class="text-[#6f6f6f] dark:text-[#8f8f8f]">Software Engineer, Vercel Labs</p>
		</header>

		<section class="mt-36">
			<h2 class="in mb-6" style={d()}>Today</h2>
			<p class="in text-[#6f6f6f] dark:text-[#8f8f8f]" style={d()}>
				I build at the frontier of what agents and interfaces can do. At Vercel Labs I work on agent tooling. Outside of it I run Crafter Station, a community of 1,000+ builders in Peru.
			</p>
		</section>

		<section class="mt-36">
			<h2 class="in mb-8" style={d()}>Projects</h2>
			<ul class="flex flex-col gap-7">
				{projects.map((p) => (
					<li class="in" style={d()}>
						<a href={p.url} target="_blank" class="group block">
							<span class="block transition-opacity group-hover:opacity-60">{p.name}</span>
							<span class="block text-[#6f6f6f] dark:text-[#8f8f8f]">{p.description}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="mt-36">
			<h2 class="in mb-8" style={d()}>Writing</h2>
			<ul class="flex flex-col gap-7">
				{posts.map((p) => (
					<li class="in" style={d()}>
						<a href={`/blog/${p.slug}`} class="group block">
							<span class="block transition-opacity group-hover:opacity-60">{p.data.title}</span>
							<span class="block text-[#6f6f6f] dark:text-[#8f8f8f]">{p.data.pubDate.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="mt-36">
			<h2 class="in mb-8" style={d()}>Talks</h2>
			<ul class="flex flex-col gap-7">
				{appearances.filter((a) => a.kind === "Talk").map((a) => (
					<li class="in" style={d()}>
						<a href={a.url} target="_blank" class="group block">
							<span class="block transition-opacity group-hover:opacity-60">{a.title}</span>
							<span class="block text-[#6f6f6f] dark:text-[#8f8f8f]">{a.where}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<footer class="in mt-36 flex gap-5 text-[#6f6f6f] dark:text-[#8f8f8f]" style={d()}>
			<a href="https://x.com/raillyhugo" class="hover:text-current">X</a>
			<a href="https://github.com/railly" class="hover:text-current">GitHub</a>
			<a href="mailto:hi@railly.dev" class="hover:text-current">Email</a>
		</footer>
	</main>
</Layout>

<style>
	.in {
		opacity: 0;
		animation: v2-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: var(--d);
	}
	@keyframes v2-in {
		from { opacity: 0; filter: blur(4px); transform: translateY(6px); }
		to { opacity: 1; filter: blur(0); transform: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.in { opacity: 1; animation: none; }
	}
</style>
