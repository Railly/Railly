---
import BrandIcon from "@/components/brand/BrandIcon.astro";
import Button from "@/components/editorial/Button.astro";
import List from "@/components/editorial/List.astro";
import ListRow from "@/components/editorial/ListRow.astro";
import PageHero from "@/components/editorial/PageHero.astro";
import Section from "@/components/editorial/Section.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import { ogUrl } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
---

<Layout
	image={ogUrl({ title: "Contact", description: "How to reach Railly Hugo for work, talks and press.", tag: "contact" })}
	title="Contact Railly Hugo | railly.dev"
	description="Official contact information for Railly Hugo, software engineer, open-source maintainer, speaker, and founder of Crafter Station."
>
	<PageLayout class="flex flex-col">
		<PageHero eyebrow={["Contact", "Work", "Talks", "Press"]} title="Contact Railly Hugo">
			<Fragment slot="lede">
				The canonical contact address for Railly Hugo and railly.dev is
				<a href="mailto:hi@railly.dev" class="ed-link text-foreground">hi@railly.dev</a>.
				Use it for collaboration, speaking, open-source work, developer tools,
				AI research, mentoring, press, or corrections to this website. Include a
				clear subject, the relevant project or page, and the action you are requesting.
			</Fragment>
			<div class="flex flex-wrap gap-3">
				<Button href="mailto:hi@railly.dev" variant="primary">hi@railly.dev</Button>
			</div>
		</PageHero>

		<Section id="h-where" number={1} title="Where to write" class="mt-16">
			<p class="text-[15px] leading-relaxed text-foreground-2">
				For public technical work, prefer the matching GitHub repository so the
				discussion remains searchable and useful to contributors. For security reports,
				follow <a href="/.well-known/security.txt" class="ed-link text-foreground">security.txt</a>
				and avoid publishing exploit details before remediation. This personal site
				does not provide emergency support, a public phone number, or guaranteed response times.
			</p>
			<List>
				<ListRow href="https://github.com/Railly" title="GitHub" description="@Railly">
					<BrandIcon slot="leading" name="github" width={14} height={14} />
				</ListRow>
				<ListRow href="https://linkedin.com/in/railly-hugo" title="LinkedIn" description="Railly Hugo">
					<span slot="leading" />
				</ListRow>
				<ListRow href="https://x.com/raillyhugo" title="X" description="@raillyhugo">
					<BrandIcon slot="leading" name="x" width={14} height={14} />
				</ListRow>
			</List>
		</Section>
	</PageLayout>
</Layout>
