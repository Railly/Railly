---
import SectionHeader from "@/components/layout/SectionHeader.astro";
---

<section class="w-full" aria-label="Newsletter on Substack">
    <div class="mb-4">
        <SectionHeader title="Newsletter" className="mb-0" />
    </div>
    <a class="substack-card" href="https://railly.substack.com">
        <div class="substack-heading">
            <span class="substack-label">
                <svg width="18" height="21" viewBox="0 0 24 28" fill="currentColor" aria-hidden="true">
                    <path d="M0 0h24v2H0zm0 5h24v2H0zm0 5h24v18l-12-7-12 7z" />
                </svg>
                <span>ON SUBSTACK</span>
            </span>
            <span class="substack-arrow" aria-hidden="true">↗</span>
        </div>
        <h3>Notes from the workbench.</h3>
        <p>What I’m building, learning, and figuring out along the way.</p>
        <div class="substack-footer">
            <span class="substack-address">railly.substack.com</span>
            <span class="substack-cta">Read & subscribe <span aria-hidden="true">↗</span></span>
        </div>
    </a>
</section>

<style>
    .substack-card {
        display: block;
        padding: 1.5rem;
        border: 1px solid var(--color-ui-2);
        border-radius: 0.25rem;
        background: var(--color-background-2);
        color: var(--color-foreground);
        transition: border-color 160ms ease, background-color 160ms ease;
    }
    .substack-card:hover {
        border-color: var(--color-foreground-2);
    }
    .substack-card:focus-visible {
        outline: 2px solid var(--color-foreground);
        outline-offset: 4px;
    }
    .substack-heading, .substack-label, .substack-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }
    .substack-label {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.08em;
        color: var(--color-foreground-2);
    }
    .substack-arrow {
        color: var(--color-foreground-2);
        font-size: 1.375rem;
    }
    h3 {
        margin: 1.25rem 0 0.5rem;
        font-family: var(--font-serif);
        font-size: clamp(1.75rem, 5vw, 2.25rem);
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.025em;
    }
    p {
        margin: 0;
        color: var(--color-foreground-2);
        font-size: 0.875rem;
        line-height: 1.7;
    }
    .substack-footer {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-ui-2);
        flex-wrap: wrap;
    }
    .substack-address {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-foreground-2);
    }
    .substack-cta {
        font-size: 0.75rem;
    }
    .substack-cta span {
        margin-left: 0.375rem;
    }
    @media (max-width: 480px) {
        .substack-card { padding: 1.125rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        .substack-card { transition: none; }
    }
</style>
