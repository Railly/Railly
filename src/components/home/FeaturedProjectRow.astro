---
import ListRow from "@/components/editorial/ListRow.astro";
import BrandIcon from "../brand/BrandIcon.astro";
import type { BrandName } from "../brand/registry";

// One selected project as an editorial row: mark + name | description + role,
// stars on the right. Renders an <li>; place it inside an editorial <List>.
interface Props {
	project: {
		name: string;
		description: string;
		role?: string;
		url: string;
		icon: BrandName;
		stars: number;
	};
}

const { project } = Astro.props;

// Stars only where they say something; small repos show the role alone.
const starLabel =
	project.stars >= 100
		? new Intl.NumberFormat("en-US", {
				notation: "compact",
				maximumFractionDigits: 1,
			}).format(project.stars)
		: "";
---

<ListRow href={project.url} external={project.url.startsWith("http")} title={project.name} meta={starLabel} arrow={false}>
	<BrandIcon slot="leading" name={project.icon} width={14} height={14} />
	<span slot="description" class="flex flex-col gap-0.5">
		<span>{project.description}</span>
		{project.role && <span class="text-foreground-2">{project.role}</span>}
	</span>
</ListRow>
