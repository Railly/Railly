---
import BrandIcon from "../brand/BrandIcon.astro";
import type { BrandName } from "../brand/registry";

interface Props {
	project: {
		name: string;
		description: string;
		role?: string;
		url: string;
		icon: BrandName;
		stars: number;
	};
}

const { project } = Astro.props;

// Stars only where they say something; small repos show the role alone.
const starLabel =
	project.stars >= 100
		? new Intl.NumberFormat("en-US", {
				notation: "compact",
				maximumFractionDigits: 1,
			}).format(project.stars)
		: null;
---

<a
	href={project.url}
	target={project.url.startsWith("http") ? "_blank" : undefined}
	rel="noopener noreferrer"
	class="group -mx-3 flex items-start gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-background-2"
>
	<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center">
		<BrandIcon name={project.icon} width={18} height={18} class="text-foreground" />
	</span>

	<span class="flex min-w-0 flex-1 flex-col gap-0.5">
		<span class="flex items-baseline gap-2">
			<span class="text-sm font-medium text-foreground">{project.name}</span>
			<span class="hidden min-w-0 truncate text-sm text-foreground-3 md:block">{project.description}</span>
		</span>
		{project.role && <span class="text-sm text-foreground-2">{project.role}</span>}
	</span>

	{
		starLabel && (
			<span class="mt-0.5 flex shrink-0 items-center gap-1 font-mono text-xs tabular-nums text-foreground-3 transition-colors group-hover:text-foreground-2">
				{starLabel}
				<span aria-hidden class="text-[0.7rem] leading-none">★</span>
			</span>
		)
	}
</a>
