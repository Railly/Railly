---
import type { CrafterMermaidOptions } from "@crafter/mermaid";
import { render } from "@crafter/mermaid";

interface Props {
	chart: string;
	class?: string;
	options?: CrafterMermaidOptions;
}

const { chart, class: className, options = {} } = Astro.props;

const defaultOptions: CrafterMermaidOptions = {
	theme: { bg: "transparent", fg: "currentColor" },
	transparent: true,
	...options,
};

const svg = render(chart.trim(), defaultOptions);
---
<div class:list={["mermaid-diagram my-8 overflow-x-auto", className]} set:html={svg} />

<style>
  .mermaid-diagram {
    -webkit-overflow-scrolling: touch;
  }
  .mermaid-diagram :global(svg) {
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
  /* The renderer only mixes hex colors, so the palette comes from site tokens instead. */
  .mermaid-diagram :global(svg) {
    --_text: var(--color-foreground) !important;
    --_line: var(--color-foreground-3) !important;
    --_arrow: var(--color-foreground-3) !important;
    --_node-fill: var(--color-background-2) !important;
    --_node-stroke: var(--color-ui-3) !important;
    --_muted: var(--color-foreground-3) !important;
    --_group-fill: var(--color-background-2) !important;
    --_group-stroke: var(--color-ui-2) !important;
    --_group-text: var(--color-foreground-2) !important;
    font-family: var(--font-sans);
  }
  .mermaid-diagram :global(svg text) {
    font-family: var(--font-sans);
    user-select: none;
  }
</style>
