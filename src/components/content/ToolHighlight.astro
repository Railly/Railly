---
// Link card for a tool a post relies on: tile that lifts on hover.
interface Props {
	name: string;
	url: string;
	logo?: string;
	description: string;
}

const { name, url, logo, description } = Astro.props;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class="ed ed-tile ed-tile-box not-prose group my-10 flex items-start gap-4 p-5"
>
	{logo && (
		<span class="flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-[4px] border border-[var(--ed-line)]">
			<img src={logo} alt={`${name} logo`} class="h-6 w-6 object-contain" />
		</span>
	)}
	<span class="flex min-w-0 flex-1 flex-col gap-1.5">
		<span class="font-serif text-[21px] leading-tight text-foreground">
			Powered by {name}
		</span>
		<span class="text-[14px] leading-relaxed text-foreground-2 [&_code]:font-mono [&_code]:text-xs">
			{description}
		</span>
		<span class="ed-label mt-1 inline-flex items-center gap-1 group-hover:text-foreground">
			Learn more about {name}
			<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
		</span>
	</span>
</a>
