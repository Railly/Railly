---
// Metric tiles: Redaction value, sans label, mono detail.
interface Metric {
	value: string;
	label: string;
	detail?: string;
}

interface Props {
	items: Metric[];
}

const { items } = Astro.props;
---

<div class="not-prose my-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
	{items.map((item) => (
		<div class="ed-tile flex flex-col gap-1.5 bg-background px-4 py-4">
			<p class="font-serif text-[28px] leading-none text-foreground [font-variant-numeric:tabular-nums]">
				{item.value}
			</p>
			<p class="text-[13.5px] leading-snug font-medium text-foreground-2">{item.label}</p>
			{item.detail && <p class="ed-label">{item.detail}</p>}
		</div>
	))}
</div>
