---
// Image in a hairline tile with the offset shadow; caption as a mono label.
interface Props {
	src: string;
	alt: string;
	caption?: string;
	size?: "sm" | "md" | "lg" | "full";
}

const { src, alt, caption, size = "md" } = Astro.props;

const maxWidths = {
	sm: "max-w-xs",
	md: "max-w-md",
	lg: "max-w-lg",
	full: "max-w-full",
};
---

<figure class={`not-prose mx-auto my-10 ${maxWidths[size]}`}>
	<img
		src={src}
		alt={alt}
		class="ed-tile w-full bg-background-2"
		loading="lazy"
	/>
	{caption && (
		<figcaption class="ed-label mt-3 text-center [text-wrap:balance]">
			{caption}
		</figcaption>
	)}
</figure>
