---
// Markdown blockquotes render here: a Redaction pull quote with a faded
// opening mark and a mono attribution after a hairline.
interface Props {
	author?: string;
	source?: string;
	href?: string;
}

const { author, source, href } = Astro.props;

const Wrapper = href ? "a" : "figure";
---

<Wrapper
    href={href}
    target={href ? "_blank" : undefined}
    rel={href ? "noopener noreferrer" : undefined}
    class:list={["pull-quote not-prose", href && "pull-quote-link"]}
>
    <blockquote class="quote-block">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <slot />
    </blockquote>
    {
        author && (
            <figcaption class="quote-by">
                <span class="quote-rule" aria-hidden="true" />
                <span class="quote-author">{author}</span>
                {source && <span class="quote-source">{source}</span>}
            </figcaption>
        )
    }
</Wrapper>

<style>
    .pull-quote {
        display: block;
        margin: 3rem 0;
        text-decoration: none;
        color: inherit;
    }
    .pull-quote-link {
        transition: opacity 0.2s ease;
    }
    .pull-quote-link:hover {
        opacity: 0.8;
    }
    .quote-block {
        position: relative;
        margin: 0;
        padding: 0;
        border: 0;
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: clamp(1.4rem, 3.4vw, 1.75rem);
        line-height: 1.32;
        letter-spacing: -0.01em;
        color: var(--color-foreground);
        text-wrap: pretty;
    }
    .quote-mark {
        position: absolute;
        left: -0.55em;
        color: var(--color-foreground-3);
        user-select: none;
    }
    .quote-block :global(p) {
        margin: 0;
        font: inherit;
    }
    .quote-block :global(p + p) {
        margin-top: 0.6em;
    }
    .quote-block :global(p:last-child::after) {
        content: "\201D";
        margin-left: 0.05em;
        color: var(--color-foreground-3);
    }
    .quote-block :global(strong) {
        font-weight: 400;
    }
    .quote-block :global(code) {
        font-size: 0.7em;
    }
    .quote-by {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.625rem;
        margin-top: 1.25rem;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.02em;
        color: var(--color-foreground-3);
    }
    .quote-rule {
        width: 2rem;
        height: 1px;
        align-self: center;
        background: var(--ed-line-2);
    }
    .quote-author {
        color: var(--color-foreground-2);
    }
    @media (max-width: 640px) {
        .quote-block {
            padding-left: 0.5em;
        }
        .quote-mark {
            left: 0;
        }
    }
</style>
