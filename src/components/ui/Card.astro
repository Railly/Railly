---
import type { ColorName } from "@/lib/colors";

interface Props {
	href?: string;
	target?: "_blank" | "_self";
	color?: ColorName;
	className?: string;
	transitionName?: string;
	padding?: string;
}

const {
	href,
	target = "_blank",
	color = "blue",
	className,
	transitionName,
	padding = "p-3",
} = Astro.props;

// Editorial tile: hairline box with the offset shadow; links lift on hover.
// `color` is kept for API compatibility and no longer tints the card.
const Component = href ? "a" : "div";
void color;
---

<Component
	href={href}
	target={href ? target : undefined}
	class:list={["ed ed-tile ed-tile-box group relative overflow-hidden", href && "block", className]}
	transition:name={transitionName}
	transition:animate="fade"
>
	<div class:list={["relative h-full flex-1", padding]} data-card-content="true">
		<slot />
	</div>
</Component>
