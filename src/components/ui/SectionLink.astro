---
import SectionHeader from "@/components/layout/SectionHeader.astro";

interface Props {
	title: string;
	href: string;
	viewAllLabel?: string;
}

const { title, href, viewAllLabel = "view all" } = Astro.props;
---

<div class="ed mb-3 flex items-baseline justify-between gap-4">
	<SectionHeader title={title} className="mb-0" />
	<a href={href} class="ed-label group inline-flex items-center gap-1">
		<span>{viewAllLabel}</span>
		<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
	</a>
</div>
