---
import type { ColorName } from "@/lib/colors";

interface Props {
	color?: ColorName;
	padding?: "p-2.5" | "p-3" | "p-4";
}

const { color = "blue", padding = "" } = Astro.props;

// `color` is kept for API compatibility; the editorial icon well is monochrome.
void color;
---

<div
    class:list={[
        "ed-art flex size-12 flex-shrink-0 items-center justify-center bg-background-2",
        padding,
    ]}
>
    <slot />
</div>
