---
import Garua from "@/components/scene/Garua.astro";
import Navigation from "./Navigation.astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Garua rest />
<div class="relative z-[1]">
	<Navigation />
	<main class="mx-auto max-w-[44rem] px-6 pt-16 pb-[34vh] text-foreground sm:pt-20">
		<div class:list={["w-full", className]}>
			<slot />
		</div>
		<slot name="rightSidebar" />
	</main>
</div>
