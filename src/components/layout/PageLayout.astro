---
import Navigation from "./Navigation.astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Navigation />
<main class="mx-auto max-w-[38rem] px-5 pt-16 pb-10 text-foreground sm:pt-20">
	<div class:list={["w-full", className]}>
		<slot />
	</div>
	<slot name="rightSidebar" />
</main>
