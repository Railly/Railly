---
import Navigation from "./Navigation.astro";

interface Props {
	class?: string;
	wide?: boolean;
}

const { class: className, wide = false } = Astro.props;
---

<Navigation />
<main
	class:list={[
		"mx-auto px-4 pt-10 pb-10 text-foreground sm:px-6 sm:pt-16",
		wide ? "max-w-[80rem]" : "max-w-[46rem]",
	]}
>
	<div class:list={["w-full", className]}>
		<slot />
	</div>
	<slot name="rightSidebar" />
</main>
