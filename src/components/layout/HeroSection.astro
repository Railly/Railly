---
interface Props {
	name: string;
	title: string;
}

const { name } = Astro.props;

const link =
	"text-foreground underline decoration-ui-3 underline-offset-4 transition-colors hover:decoration-foreground";
---

<section class="flex flex-col gap-4 text-[15px] leading-relaxed">
	<h1 class="font-medium text-foreground">
		{name}
		<span class="block font-normal text-foreground-3">Software engineer at Vercel Labs</span>
	</h1>
	<p class="text-foreground">I build at the frontier of what agents and interfaces can do.</p>
	<p class="text-foreground-2">
		Right now that means agent tooling at <a href="https://vercel.com/labs" target="_blank" class={link}>Vercel Labs</a>. I also run <a href="https://github.com/crafter-station" target="_blank" class={link}>Crafter Station</a>, a community of 1,000+ builders in Peru, and open civic tech at <a href="https://github.com/crafter-research" target="_blank" class={link}>Crafter Research</a>. Based in Buenos Aires, from Lima.
	</p>
	<p class="text-foreground-2">
		<a href="https://github.com/railly" target="_blank" class={link}>GitHub</a>, <a href="https://x.com/raillyhugo" target="_blank" class={link}>X</a>, <a href="mailto:hi@railly.dev" class={link}>email</a>.
	</p>
</section>
